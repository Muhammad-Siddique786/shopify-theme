{% doc %}
  @prompt
    Create a product reviews carousel section that displays every review in one continuous horizontal row without wrapping to a second row. Show one review card at a time on mobile and multiple cards in one row on desktop, with clear previous and next arrow buttons and smooth horizontal scrolling. Keep the existing review content, styling controls, and responsive behavior, and make the carousel accessible with keyboard navigation and suitable labels., slider jo hai wo heading ka samna bnao jaise<1/5> aise bnao oe review is trh bnao ka pehla customer ka mane phir rating phir comment phir ak vertical line phir os product ka link, jo icon hai next or back ka osay <1/5> bna do or row sa hta do, counting ko icon ka center mai kr do 
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% liquid
  assign total_reviews = 0
  for i in (1..10)
    assign review_enabled_key = 'review_' | append: i | append: '_enabled'
    assign review_enabled = block.settings[review_enabled_key]
    if review_enabled
      assign total_reviews = total_reviews | plus: 1
    endif
  endfor
%}

{% style %}
  .ai-reviews-carousel-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    position: relative;
    padding: {{ block.settings.section_padding }}px 0;
    background-color: {{ block.settings.background_color }};
  }

  .ai-reviews-carousel__header-{{ ai_gen_id }} {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin: 0 0 {{ block.settings.heading_margin }}px;
    padding: 0 20px;
  }

  .ai-reviews-carousel__heading-{{ ai_gen_id }} {
    margin: 0;
    color: {{ block.settings.heading_color }};
    font-size: {{ block.settings.heading_size }}px;
  }

  .ai-reviews-carousel__controls-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    gap: 16px;
  }

  .ai-reviews-carousel__counter-{{ ai_gen_id }} {
    font-size: {{ block.settings.counter_size }}px;
    color: {{ block.settings.counter_color }};
    font-weight: 600;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-reviews-carousel__nav-buttons-{{ ai_gen_id }} {
    display: flex;
    gap: 8px;
    align-items: center;
  }

  .ai-reviews-carousel__wrapper-{{ ai_gen_id }} {
    position: relative;
    max-width: 100%;
    margin: 0 auto;
    padding: 0 20px;
  }

  .ai-reviews-carousel__container-{{ ai_gen_id }} {
    overflow: hidden;
    position: relative;
  }

  .ai-reviews-carousel__track-{{ ai_gen_id }} {
    display: flex;
    gap: {{ block.settings.card_gap }}px;
    transition: transform 0.5s ease;
    will-change: transform;
  }

  .ai-reviews-carousel__card-{{ ai_gen_id }} {
    flex: 0 0 auto;
    width: calc(100% - 20px);
    background-color: {{ block.settings.card_bg_color }};
    border-radius: {{ block.settings.card_border_radius }}px;
    padding: {{ block.settings.card_padding }}px;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
    display: flex;
    flex-direction: column;
    gap: {{ block.settings.content_spacing }}px;
  }

  .ai-reviews-carousel__reviewer-name-{{ ai_gen_id }} {
    font-weight: 600;
    font-size: {{ block.settings.reviewer_name_size }}px;
    color: {{ block.settings.reviewer_name_color }};
  }

  .ai-reviews-carousel__stars-{{ ai_gen_id }} {
    display: flex;
    gap: 4px;
  }

  .ai-reviews-carousel__star-{{ ai_gen_id }} {
    width: {{ block.settings.star_size }}px;
    height: {{ block.settings.star_size }}px;
    fill: {{ block.settings.star_color }};
  }

  .ai-reviews-carousel__star--empty-{{ ai_gen_id }} {
    fill: {{ block.settings.star_empty_color }};
  }

  .ai-reviews-carousel__review-text-{{ ai_gen_id }} {
    font-size: {{ block.settings.review_text_size }}px;
    color: {{ block.settings.review_text_color }};
    line-height: 1.5;
  }

  .ai-reviews-carousel__divider-{{ ai_gen_id }} {
    width: 1px;
    height: 40px;
    background-color: {{ block.settings.divider_color }};
    margin: {{ block.settings.divider_spacing }}px 0;
  }

  .ai-reviews-carousel__product-link-{{ ai_gen_id }} {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: {{ block.settings.link_color }};
    text-decoration: none;
    font-size: {{ block.settings.link_size }}px;
    font-weight: 500;
    transition: color 0.3s ease;
  }

  .ai-reviews-carousel__product-link-{{ ai_gen_id }}:hover {
    color: {{ block.settings.link_hover_color }};
  }

  .ai-reviews-carousel__link-icon-{{ ai_gen_id }} {
    width: 16px;
    height: 16px;
    stroke: currentColor;
    fill: none;
  }

  .ai-reviews-carousel__nav-button-{{ ai_gen_id }} {
    width: {{ block.settings.nav_button_size }}px;
    height: {{ block.settings.nav_button_size }}px;
    background-color: {{ block.settings.nav_button_bg }};
    border: none;
    border-radius: 50%;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background-color 0.3s ease;
  }

  .ai-reviews-carousel__nav-button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.nav_button_hover_bg }};
  }

  .ai-reviews-carousel__nav-button-{{ ai_gen_id }}:disabled {
    opacity: 0.3;
    cursor: not-allowed;
  }

  .ai-reviews-carousel__nav-icon-{{ ai_gen_id }} {
    width: 20px;
    height: 20px;
    stroke: {{ block.settings.nav_button_icon_color }};
    fill: none;
  }

  @media screen and (min-width: 750px) {
    .ai-reviews-carousel__card-{{ ai_gen_id }} {
      width: {{ block.settings.card_width_desktop }}px;
    }
  }

  @media screen and (max-width: 749px) {
    .ai-reviews-carousel__header-{{ ai_gen_id }} {
      flex-direction: column;
      gap: 12px;
      align-items: flex-start;
    }

    .ai-reviews-carousel__nav-button-{{ ai_gen_id }} {
      width: 36px;
      height: 36px;
    }

    .ai-reviews-carousel__nav-icon-{{ ai_gen_id }} {
      width: 16px;
      height: 16px;
    }
  }
{% endstyle %}

<product-reviews-carousel-{{ ai_gen_id }}
  class="ai-reviews-carousel-{{ ai_gen_id }}"
  {{ block.shopify_attributes }}
  data-auto-scroll="{{ block.settings.auto_scroll }}"
  data-auto-scroll-delay="{{ block.settings.auto_scroll_delay }}"
  data-total-reviews="{{ total_reviews }}"
>
  <div class="ai-reviews-carousel__header-{{ ai_gen_id }}">
    {% if block.settings.heading != blank %}
      <h2 class="ai-reviews-carousel__heading-{{ ai_gen_id }}">{{ block.settings.heading }}</h2>
    {% endif %}
    <div class="ai-reviews-carousel__controls-{{ ai_gen_id }}">
      <button
        class="ai-reviews-carousel__nav-button-{{ ai_gen_id }}"
        aria-label="Previous review"
        data-prev
      >
        <svg class="ai-reviews-carousel__nav-icon-{{ ai_gen_id }}" viewBox="0 0 24 24" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="15 18 9 12 15 6"></polyline>
        </svg>
      </button>
      <div class="ai-reviews-carousel__counter-{{ ai_gen_id }}" data-counter>
        <span data-current>1</span>/<span data-total>{{ total_reviews }}</span>
      </div>
      <button
        class="ai-reviews-carousel__nav-button-{{ ai_gen_id }}"
        aria-label="Next review"
        data-next
      >
        <svg class="ai-reviews-carousel__nav-icon-{{ ai_gen_id }}" viewBox="0 0 24 24" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="9 18 15 12 9 6"></polyline>
        </svg>
      </button>
    </div>
  </div>

  <div class="ai-reviews-carousel__wrapper-{{ ai_gen_id }}">
    <div class="ai-reviews-carousel__container-{{ ai_gen_id }}" data-container>
      <div class="ai-reviews-carousel__track-{{ ai_gen_id }}" data-track>
        {% for i in (1..10) %}
          {% liquid
            assign review_enabled_key = 'review_' | append: i | append: '_enabled'
            assign review_text_key = 'review_' | append: i | append: '_text'
            assign reviewer_name_key = 'review_' | append: i | append: '_name'
            assign review_rating_key = 'review_' | append: i | append: '_rating'
            assign product_key = 'review_' | append: i | append: '_product'

            assign review_enabled = block.settings[review_enabled_key]
            assign review_text = block.settings[review_text_key]
            assign reviewer_name = block.settings[reviewer_name_key]
            assign review_rating = block.settings[review_rating_key]
            assign product = block.settings[product_key]
          %}

          {% if review_enabled %}
            <div class="ai-reviews-carousel__card-{{ ai_gen_id }}">
              {% if reviewer_name != blank %}
                <div class="ai-reviews-carousel__reviewer-name-{{ ai_gen_id }}">{{ reviewer_name }}</div>
              {% endif %}

              <div class="ai-reviews-carousel__stars-{{ ai_gen_id }}">
                {% for star in (1..5) %}
                  <svg class="ai-reviews-carousel__star-{{ ai_gen_id }} {% if star > review_rating %}ai-reviews-carousel__star--empty-{{ ai_gen_id }}{% endif %}" viewBox="0 0 24 24">
                    <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
                  </svg>
                {% endfor %}
              </div>

              {% if review_text != blank %}
                <p class="ai-reviews-carousel__review-text-{{ ai_gen_id }}">{{ review_text }}</p>
              {% endif %}

              <div class="ai-reviews-carousel__divider-{{ ai_gen_id }}"></div>

              {% if product != blank %}
                <a href="{{ product.url }}" class="ai-reviews-carousel__product-link-{{ ai_gen_id }}">
                  <span>{{ product.title }}</span>
                  <svg class="ai-reviews-carousel__link-icon-{{ ai_gen_id }}" viewBox="0 0 24 24" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="5" y1="12" x2="19" y2="12"></line>
                    <polyline points="12 5 19 12 12 19"></polyline>
                  </svg>
                </a>
              {% else %}
                <span class="ai-reviews-carousel__product-link-{{ ai_gen_id }}" style="opacity: 0.5; cursor: default;">
                  Add a product
                </span>
              {% endif %}
            </div>
          {% endif %}
        {% endfor %}
      </div>
    </div>
  </div>
</product-reviews-carousel-{{ ai_gen_id }}>

<script>
  (function() {
    class ProductReviewsCarousel{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.currentIndex = 0;
        this.autoScrollTimer = null;
      }

      connectedCallback() {
        this.track = this.querySelector('[data-track]');
        this.container = this.querySelector('[data-container]');
        this.prevButton = this.querySelector('[data-prev]');
        this.nextButton = this.querySelector('[data-next]');
        this.counterCurrent = this.querySelector('[data-current]');
        this.cards = Array.from(this.track.children);
        this.autoScroll = this.dataset.autoScroll === 'true';
        this.autoScrollDelay = parseInt(this.dataset.autoScrollDelay) * 1000;

        if (this.cards.length === 0) return;

        this.setupEventListeners();
        this.updateCarousel();
        this.setupKeyboardNavigation();

        if (this.autoScroll) {
          this.startAutoScroll();
        }
      }

      setupEventListeners() {
        this.prevButton.addEventListener('click', () => this.goToPrev());
        this.nextButton.addEventListener('click', () => this.goToNext());

        window.addEventListener('resize', () => this.updateCarousel());

        this.container.addEventListener('mouseenter', () => {
          if (this.autoScroll) {
            this.stopAutoScroll();
          }
        });

        this.container.addEventListener('mouseleave', () => {
          if (this.autoScroll) {
            this.startAutoScroll();
          }
        });
      }

      setupKeyboardNavigation() {
        this.prevButton.addEventListener('keydown', (e) => {
          if (e.key === 'Enter' || e.key === ' ') {
            e.preventDefault();
            this.goToPrev();
          }
        });

        this.nextButton.addEventListener('keydown', (e) => {
          if (e.key === 'Enter' || e.key === ' ') {
            e.preventDefault();
            this.goToNext();
          }
        });
      }

      getCardsPerView() {
        return window.innerWidth >= 750 ? this.getDesktopCardsPerView() : 1;
      }

      getDesktopCardsPerView() {
        const containerWidth = this.container.offsetWidth;
        const cardWidth = this.cards[0].offsetWidth;
        const gap = parseInt(getComputedStyle(this.track).gap) || 0;
        return Math.floor((containerWidth + gap) / (cardWidth + gap));
      }

      goToNext() {
        const cardsPerView = this.getCardsPerView();
        const maxIndex = this.cards.length - cardsPerView;
        
        if (this.currentIndex < maxIndex) {
          this.currentIndex++;
          this.updateCarousel();
        }

        if (this.autoScroll) {
          this.resetAutoScroll();
        }
      }

      goToPrev() {
        if (this.currentIndex > 0) {
          this.currentIndex--;
          this.updateCarousel();
        }

        if (this.autoScroll) {
          this.resetAutoScroll();
        }
      }

      updateCarousel() {
        const cardWidth = this.cards[0].offsetWidth;
        const gap = parseInt(getComputedStyle(this.track).gap) || 0;
        const offset = this.currentIndex * (cardWidth + gap);
        
        this.track.style.transform = `translateX(-${offset}px)`;

        const cardsPerView = this.getCardsPerView();
        const maxIndex = this.cards.length - cardsPerView;

        this.prevButton.disabled = this.currentIndex === 0;
        this.nextButton.disabled = this.currentIndex >= maxIndex;

        if (this.counterCurrent) {
          this.counterCurrent.textContent = this.currentIndex + 1;
        }
      }

      startAutoScroll() {
        this.autoScrollTimer = setInterval(() => {
          const cardsPerView = this.getCardsPerView();
          const maxIndex = this.cards.length - cardsPerView;
          
          if (this.currentIndex < maxIndex) {
            this.goToNext();
          } else {
            this.currentIndex = 0;
            this.updateCarousel();
          }
        }, this.autoScrollDelay);
      }

      stopAutoScroll() {
        if (this.autoScrollTimer) {
          clearInterval(this.autoScrollTimer);
          this.autoScrollTimer = null;
        }
      }

      resetAutoScroll() {
        this.stopAutoScroll();
        this.startAutoScroll();
      }

      disconnectedCallback() {
        this.stopAutoScroll();
        window.removeEventListener('resize', () => this.updateCarousel());
      }
    }

    customElements.define('product-reviews-carousel-{{ ai_gen_id }}', ProductReviewsCarousel{{ ai_gen_id }});
  })();
</script>

