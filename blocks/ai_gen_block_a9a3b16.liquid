{% doc %}
  @prompt
    Create a polished four-feature benefits block for The Cloud Bedding with four equal columns and clearly visible minimalist line icons. Use a delivery truck icon for “Fast Shipping,” circular exchange arrows for “Exchange Policy,” a chat bubble or headset icon for “Online Support,” and a payment card or secure payment icon for “Advance Payment.” Keep the titles exactly as written, make the icons prominent above each title, match the store’s existing theme styling, and make the layout responsive so it stacks neatly on mobile while showing four columns on desktop., ak to ak hi row mai 4 ko set kro dosra pehla icon lagaon jo mna description di hai oska hisab sa phir icon left side pa ho or osaka agry tiltle or descripltion likho braber mai
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-benefits-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    padding: {{ block.settings.section_padding }}px 20px;
    background-color: {{ block.settings.background_color }};
  }

  .ai-benefits-container-{{ ai_gen_id }} {
    max-width: {{ block.settings.max_width }}px;
    margin: 0 auto;
  }

  .ai-benefits-grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: {{ block.settings.column_gap }}px;
  }

  .ai-benefits-item-{{ ai_gen_id }} {
    display: flex;
    flex-direction: row;
    align-items: flex-start;
    text-align: left;
    padding: {{ block.settings.item_padding }}px;
    gap: {{ block.settings.icon_text_gap }}px;
  }

  .ai-benefits-icon-wrapper-{{ ai_gen_id }} {
    width: {{ block.settings.icon_size }}px;
    height: {{ block.settings.icon_size }}px;
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-benefits-icon-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    stroke: {{ block.settings.icon_color }};
    stroke-width: {{ block.settings.icon_stroke_width }};
    fill: none;
  }

  .ai-benefits-content-{{ ai_gen_id }} {
    flex: 1;
  }

  .ai-benefits-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.title_size }}px;
    font-weight: {{ block.settings.title_weight }};
    color: {{ block.settings.title_color }};
    margin: 0 0 {{ block.settings.title_margin_bottom }}px 0;
    line-height: 1.3;
  }

  .ai-benefits-description-{{ ai_gen_id }} {
    font-size: {{ block.settings.description_size }}px;
    color: {{ block.settings.description_color }};
    margin: 0;
    line-height: 1.5;
  }

  @media screen and (max-width: 989px) {
    .ai-benefits-grid-{{ ai_gen_id }} {
      grid-template-columns: repeat(2, 1fr);
      gap: {{ block.settings.mobile_gap }}px;
    }

    .ai-benefits-icon-wrapper-{{ ai_gen_id }} {
      width: {{ block.settings.icon_size | times: 0.8 }}px;
      height: {{ block.settings.icon_size | times: 0.8 }}px;
    }

    .ai-benefits-title-{{ ai_gen_id }} {
      font-size: {{ block.settings.title_size | times: 0.9 }}px;
    }

    .ai-benefits-description-{{ ai_gen_id }} {
      font-size: {{ block.settings.description_size | times: 0.9 }}px;
    }
  }

  @media screen and (max-width: 749px) {
    .ai-benefits-grid-{{ ai_gen_id }} {
      grid-template-columns: repeat({{ block.settings.mobile_columns }}, 1fr);
    }
  }
{% endstyle %}

<benefits-block-{{ ai_gen_id }} class="ai-benefits-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-benefits-container-{{ ai_gen_id }}">
    <div class="ai-benefits-grid-{{ ai_gen_id }}">
      <div class="ai-benefits-item-{{ ai_gen_id }}">
        <div class="ai-benefits-icon-wrapper-{{ ai_gen_id }}">
          <svg class="ai-benefits-icon-{{ ai_gen_id }}" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
            <path d="M1 3h15v13H1z" stroke-linecap="round" stroke-linejoin="round"/>
            <path d="M16 8h4l3 3v5h-7V8z" stroke-linecap="round" stroke-linejoin="round"/>
            <circle cx="5.5" cy="18.5" r="2.5" stroke-linecap="round" stroke-linejoin="round"/>
            <circle cx="18.5" cy="18.5" r="2.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </div>
        <div class="ai-benefits-content-{{ ai_gen_id }}">
          <h3 class="ai-benefits-title-{{ ai_gen_id }}">{{ block.settings.feature_1_title }}</h3>
          {% if block.settings.feature_1_description != blank %}
            <p class="ai-benefits-description-{{ ai_gen_id }}">{{ block.settings.feature_1_description }}</p>
          {% endif %}
        </div>
      </div>

      <div class="ai-benefits-item-{{ ai_gen_id }}">
        <div class="ai-benefits-icon-wrapper-{{ ai_gen_id }}">
          <svg class="ai-benefits-icon-{{ ai_gen_id }}" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
            <path d="M21 12a9 9 0 1 1-9-9" stroke-linecap="round" stroke-linejoin="round"/>
            <path d="M12 3a9 9 0 0 1 9 9" stroke-linecap="round" stroke-linejoin="round"/>
            <path d="M12 8v4l3 3" stroke-linecap="round" stroke-linejoin="round"/>
            <path d="M19 4l2 2-2 2" stroke-linecap="round" stroke-linejoin="round"/>
            <path d="M5 4L3 6l2 2" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </div>
        <div class="ai-benefits-content-{{ ai_gen_id }}">
          <h3 class="ai-benefits-title-{{ ai_gen_id }}">{{ block.settings.feature_2_title }}</h3>
          {% if block.settings.feature_2_description != blank %}
            <p class="ai-benefits-description-{{ ai_gen_id }}">{{ block.settings.feature_2_description }}</p>
          {% endif %}
        </div>
      </div>

      <div class="ai-benefits-item-{{ ai_gen_id }}">
        <div class="ai-benefits-icon-wrapper-{{ ai_gen_id }}">
          <svg class="ai-benefits-icon-{{ ai_gen_id }}" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
            <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z" stroke-linecap="round" stroke-linejoin="round"/>
            <path d="M8 10h8" stroke-linecap="round" stroke-linejoin="round"/>
            <path d="M8 14h4" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </div>
        <div class="ai-benefits-content-{{ ai_gen_id }}">
          <h3 class="ai-benefits-title-{{ ai_gen_id }}">{{ block.settings.feature_3_title }}</h3>
          {% if block.settings.feature_3_description != blank %}
            <p class="ai-benefits-description-{{ ai_gen_id }}">{{ block.settings.feature_3_description }}</p>
          {% endif %}
        </div>
      </div>

      <div class="ai-benefits-item-{{ ai_gen_id }}">
        <div class="ai-benefits-icon-wrapper-{{ ai_gen_id }}">
          <svg class="ai-benefits-icon-{{ ai_gen_id }}" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
            <rect x="1" y="4" width="22" height="16" rx="2" ry="2" stroke-linecap="round" stroke-linejoin="round"/>
            <path d="M1 10h22" stroke-linecap="round" stroke-linejoin="round"/>
            <path d="M8 14h2" stroke-linecap="round" stroke-linejoin="round"/>
            <path d="M12 14h4" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </div>
        <div class="ai-benefits-content-{{ ai_gen_id }}">
          <h3 class="ai-benefits-title-{{ ai_gen_id }}">{{ block.settings.feature_4_title }}</h3>
          {% if block.settings.feature_4_description != blank %}
            <p class="ai-benefits-description-{{ ai_gen_id }}">{{ block.settings.feature_4_description }}</p>
          {% endif %}
        </div>
      </div>
    </div>
  </div>
</benefits-block-{{ ai_gen_id }}>

<script>
(function() {
  class BenefitsBlock{{ ai_gen_id }} extends HTMLElement {
    constructor() {
      super();
    }

    connectedCallback() {
    }
  }

  customElements.define('benefits-block-{{ ai_gen_id }}', BenefitsBlock{{ ai_gen_id }});
})();
</script>

