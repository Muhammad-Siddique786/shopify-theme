{% doc %}
  @prompt
    Create a reusable Shopify theme block for the existing Multimedia collage section. On desktop, keep the left-side image visually sticky while the visitor scrolls through the product cards or product column on the right. The right side should have a controlled independent scrolling experience, and when the collage section ends, the sticky image should release and continue upward with the page. Preserve the existing collage design, responsive behavior, product links, accessibility, and normal scrolling on mobile. Include settings so the merchant can enable or disable the sticky behavior and adjust the right-column scroll height., ma chahata hon ka ak collection ki products hon jo wo coleection add krny sa khud hi a jaiy or dosra image ka agy 2 colums mai a rhi hon products, image ka size collection products ki 2 rows ka equal aya or product ki rating bhi add kro or product ka size normal rakho or products ka background transparent rakho or jb mai hover kron to nichy image ka bottom ma selct option ka buton aya or right corner sa tora nichy add to whishlist or oska nichy quick view ka icons ayaei or ni product tiltle ka nichy jhn price likhi hoi hai whn before price bhi aya or left image ko itni width do ka wo sai trh sa visible hho, image ki width collection ki products ki 2 rows ka eaqual kro,  ab image to sticky ni rhi or iski width or height ko kam zeyada krny ka option add kro, opr top  center mai section ki heading add kro or oska nichy ak line description ki bhi or side image jo hai wo fix rhy lakin prodcts ki row scroll hon 
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-sticky-collage-{{ ai_gen_id }} {
    display: block;
    width: 100%;
  }

  .ai-sticky-collage__header-{{ ai_gen_id }} {
    text-align: center;
    margin-bottom: {{ block.settings.header_spacing }}px;
  }

  .ai-sticky-collage__heading-{{ ai_gen_id }} {
    font-size: {{ block.settings.heading_size }}px;
    font-weight: 700;
    color: {{ block.settings.heading_color }};
    margin: 0 0 {{ block.settings.heading_bottom_spacing }}px;
    line-height: 1.2;
  }

  .ai-sticky-collage__description-{{ ai_gen_id }} {
    font-size: {{ block.settings.description_size }}px;
    color: {{ block.settings.description_color }};
    margin: 0;
    line-height: 1.5;
  }

  .ai-sticky-collage__container-{{ ai_gen_id }} {
    display: flex;
    gap: {{ block.settings.gap }}px;
    align-items: flex-start;
  }

  .ai-sticky-collage__left-{{ ai_gen_id }} {
    width: {{ block.settings.image_width }}%;
    flex-shrink: 0;
  }

  .ai-sticky-collage__left-inner-{{ ai_gen_id }} {
    {% if block.settings.enable_sticky %}
      position: sticky;
      top: {{ block.settings.sticky_top_offset }}px;
    {% endif %}
  }

  .ai-sticky-collage__image-wrapper-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    overflow: hidden;
    border-radius: {{ block.settings.image_border_radius }}px;
    {% if block.settings.manual_height_control %}
      height: {{ block.settings.image_height }}px;
    {% endif %}
  }

  .ai-sticky-collage__image-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
  }

  .ai-sticky-collage__image-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    min-height: 400px;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-sticky-collage__image-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-sticky-collage__right-{{ ai_gen_id }} {
    width: calc(100% - {{ block.settings.image_width }}% - {{ block.settings.gap }}px);
    flex-shrink: 0;
    {% if block.settings.enable_products_scroll %}
      max-height: {{ block.settings.products_scroll_height }}px;
      overflow-y: auto;
      overflow-x: hidden;
    {% endif %}
  }

  .ai-sticky-collage__right-{{ ai_gen_id }}::-webkit-scrollbar {
    width: 8px;
  }

  .ai-sticky-collage__right-{{ ai_gen_id }}::-webkit-scrollbar-track {
    background: #f1f1f1;
    border-radius: 4px;
  }

  .ai-sticky-collage__right-{{ ai_gen_id }}::-webkit-scrollbar-thumb {
    background: #888;
    border-radius: 4px;
  }

  .ai-sticky-collage__right-{{ ai_gen_id }}::-webkit-scrollbar-thumb:hover {
    background: #555;
  }

  .ai-sticky-collage__products-grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: {{ block.settings.product_gap }}px;
  }

  .ai-sticky-collage__product-card-{{ ai_gen_id }} {
    position: relative;
    background: transparent;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    border-radius: {{ block.settings.product_border_radius }}px;
  }

  .ai-sticky-collage__product-link-{{ ai_gen_id }} {
    text-decoration: none;
    color: inherit;
    display: block;
  }

  .ai-sticky-collage__product-image-wrapper-{{ ai_gen_id }} {
    position: relative;
    overflow: hidden;
    border-radius: {{ block.settings.product_border_radius }}px;
    background-color: #f4f4f4;
  }

  .ai-sticky-collage__product-image-{{ ai_gen_id }} {
    width: 100%;
    height: auto;
    display: block;
    aspect-ratio: 1/1;
    object-fit: cover;
  }

  .ai-sticky-collage__product-image-placeholder-{{ ai_gen_id }} {
    width: 100%;
    aspect-ratio: 1/1;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-sticky-collage__product-image-placeholder-{{ ai_gen_id }} svg {
    width: 60%;
    height: 60%;
  }

  .ai-sticky-collage__product-overlay-{{ ai_gen_id }} {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    background-color: {{ block.settings.overlay_bg_color }};
    padding: 12px;
    transform: translateY(100%);
    transition: transform 0.3s ease;
  }

  .ai-sticky-collage__product-card-{{ ai_gen_id }}:hover .ai-sticky-collage__product-overlay-{{ ai_gen_id }} {
    transform: translateY(0);
  }

  .ai-sticky-collage__select-options-btn-{{ ai_gen_id }} {
    width: 100%;
    padding: 10px 16px;
    background-color: {{ block.settings.button_bg_color }};
    color: {{ block.settings.button_text_color }};
    border: none;
    border-radius: {{ block.settings.button_border_radius }}px;
    cursor: pointer;
    font-size: 14px;
    font-weight: 600;
    transition: background-color 0.3s ease;
  }

  .ai-sticky-collage__select-options-btn-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_bg_color }};
  }

  .ai-sticky-collage__product-actions-{{ ai_gen_id }} {
    position: absolute;
    top: 10px;
    right: 10px;
    display: flex;
    flex-direction: column;
    gap: 8px;
    opacity: 0;
    transform: translateY(-10px);
    transition: opacity 0.3s ease, transform 0.3s ease;
  }

  .ai-sticky-collage__product-card-{{ ai_gen_id }}:hover .ai-sticky-collage__product-actions-{{ ai_gen_id }} {
    opacity: 1;
    transform: translateY(0);
  }

  .ai-sticky-collage__action-btn-{{ ai_gen_id }} {
    width: 40px;
    height: 40px;
    background-color: {{ block.settings.icon_bg_color }};
    border: none;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: background-color 0.3s ease, transform 0.2s ease;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
  }

  .ai-sticky-collage__action-btn-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.icon_hover_bg_color }};
    transform: scale(1.1);
  }

  .ai-sticky-collage__action-btn-{{ ai_gen_id }} svg {
    width: 20px;
    height: 20px;
    stroke: {{ block.settings.icon_color }};
    fill: none;
  }

  .ai-sticky-collage__product-info-{{ ai_gen_id }} {
    padding: 12px 0;
  }

  .ai-sticky-collage__product-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.product_title_size }}px;
    margin: 0 0 6px;
    font-weight: 600;
    color: {{ block.settings.product_title_color }};
    line-height: 1.3;
  }

  .ai-sticky-collage__product-rating-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    gap: 4px;
    margin-bottom: 6px;
  }

  .ai-sticky-collage__stars-{{ ai_gen_id }} {
    display: flex;
    gap: 2px;
  }

  .ai-sticky-collage__star-{{ ai_gen_id }} {
    width: 14px;
    height: 14px;
    fill: {{ block.settings.star_color }};
  }

  .ai-sticky-collage__star-empty-{{ ai_gen_id }} {
    fill: {{ block.settings.star_empty_color }};
  }

  .ai-sticky-collage__rating-count-{{ ai_gen_id }} {
    font-size: 12px;
    color: {{ block.settings.rating_count_color }};
  }

  .ai-sticky-collage__product-price-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-wrap: wrap;
  }

  .ai-sticky-collage__price-compare-{{ ai_gen_id }} {
    font-size: {{ block.settings.product_price_size }}px;
    color: {{ block.settings.compare_price_color }};
    text-decoration: line-through;
    opacity: 0.7;
  }

  .ai-sticky-collage__price-regular-{{ ai_gen_id }} {
    font-size: {{ block.settings.product_price_size }}px;
    font-weight: 600;
    color: {{ block.settings.product_price_color }};
  }

  .ai-sticky-collage__empty-state-{{ ai_gen_id }} {
    text-align: center;
    padding: 40px 20px;
    color: #666;
    font-size: 14px;
  }

  @media screen and (max-width: 749px) {
    .ai-sticky-collage__container-{{ ai_gen_id }} {
      flex-direction: column;
    }

    .ai-sticky-collage__left-{{ ai_gen_id }} {
      width: 100%;
    }

    .ai-sticky-collage__right-{{ ai_gen_id }} {
      width: 100%;
      max-height: none !important;
      overflow-y: visible !important;
    }

    .ai-sticky-collage__left-inner-{{ ai_gen_id }} {
      position: relative !important;
      top: auto !important;
    }

    .ai-sticky-collage__products-grid-{{ ai_gen_id }} {
      grid-template-columns: repeat({{ block.settings.mobile_columns }}, 1fr);
    }
  }
{% endstyle %}

<sticky-collage-{{ ai_gen_id }} class="ai-sticky-collage-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  {% if block.settings.heading != blank or block.settings.description != blank %}
    <div class="ai-sticky-collage__header-{{ ai_gen_id }}">
      {% if block.settings.heading != blank %}
        <h2 class="ai-sticky-collage__heading-{{ ai_gen_id }}">{{ block.settings.heading }}</h2>
      {% endif %}
      {% if block.settings.description != blank %}
        <div class="ai-sticky-collage__description-{{ ai_gen_id }}">{{ block.settings.description }}</div>
      {% endif %}
    </div>
  {% endif %}

  <div class="ai-sticky-collage__container-{{ ai_gen_id }}">
    <div class="ai-sticky-collage__left-{{ ai_gen_id }}">
      <div class="ai-sticky-collage__left-inner-{{ ai_gen_id }}" data-sticky-image>
        <div class="ai-sticky-collage__image-wrapper-{{ ai_gen_id }}">
          {% if block.settings.featured_image %}
            <img
              src="{{ block.settings.featured_image | image_url: width: 1200 }}"
              alt="{{ block.settings.featured_image.alt | escape }}"
              loading="lazy"
              width="{{ block.settings.featured_image.width }}"
              height="{{ block.settings.featured_image.height }}"
              class="ai-sticky-collage__image-{{ ai_gen_id }}"
            >
          {% else %}
            <div class="ai-sticky-collage__image-placeholder-{{ ai_gen_id }}">
              {{ 'image' | placeholder_svg_tag }}
            </div>
          {% endif %}
        </div>
      </div>
    </div>

    <div class="ai-sticky-collage__right-{{ ai_gen_id }}">
      {% if block.settings.collection != blank %}
        <div class="ai-sticky-collage__products-grid-{{ ai_gen_id }}" data-products-grid>
          {% for product in block.settings.collection.products limit: block.settings.products_limit %}
            <div class="ai-sticky-collage__product-card-{{ ai_gen_id }}">
              <a href="{{ product.url }}" class="ai-sticky-collage__product-link-{{ ai_gen_id }}">
                <div class="ai-sticky-collage__product-image-wrapper-{{ ai_gen_id }}">
                  {% if product.featured_image %}
                    <img
                      src="{{ product.featured_image | image_url: width: 600 }}"
                      alt="{{ product.featured_image.alt | escape }}"
                      loading="lazy"
                      width="600"
                      height="600"
                      class="ai-sticky-collage__product-image-{{ ai_gen_id }}"
                    >
                  {% else %}
                    <div class="ai-sticky-collage__product-image-placeholder-{{ ai_gen_id }}">
                      {{ 'product-1' | placeholder_svg_tag }}
                    </div>
                  {% endif %}

                  <div class="ai-sticky-collage__product-overlay-{{ ai_gen_id }}">
                    <button class="ai-sticky-collage__select-options-btn-{{ ai_gen_id }}" type="button">
                      Select options
                    </button>
                  </div>

                  <div class="ai-sticky-collage__product-actions-{{ ai_gen_id }}">
                    <button class="ai-sticky-collage__action-btn-{{ ai_gen_id }}" type="button" aria-label="Add to wishlist">
                      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path>
                      </svg>
                    </button>
                    <button class="ai-sticky-collage__action-btn-{{ ai_gen_id }}" type="button" aria-label="Quick view">
                      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
                        <circle cx="12" cy="12" r="3"></circle>
                      </svg>
                    </button>
                  </div>
                </div>

                <div class="ai-sticky-collage__product-info-{{ ai_gen_id }}">
                  <h3 class="ai-sticky-collage__product-title-{{ ai_gen_id }}">{{ product.title }}</h3>
                  
                  {% if block.settings.show_rating %}
                    <div class="ai-sticky-collage__product-rating-{{ ai_gen_id }}">
                      <div class="ai-sticky-collage__stars-{{ ai_gen_id }}">
                        {% for i in (1..5) %}
                          <svg class="ai-sticky-collage__star-{{ ai_gen_id }} {% if i > 4 %}ai-sticky-collage__star-empty-{{ ai_gen_id }}{% endif %}" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
                            <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
                          </svg>
                        {% endfor %}
                      </div>
                      <span class="ai-sticky-collage__rating-count-{{ ai_gen_id }}">({{ block.settings.default_rating_count }})</span>
                    </div>
                  {% endif %}

                  <div class="ai-sticky-collage__product-price-{{ ai_gen_id }}">
                    {% if product.compare_at_price > product.price %}
                      <span class="ai-sticky-collage__price-compare-{{ ai_gen_id }}">{{ product.compare_at_price | money }}</span>
                    {% endif %}
                    <span class="ai-sticky-collage__price-regular-{{ ai_gen_id }}">{{ product.price | money }}</span>
                  </div>
                </div>
              </a>
            </div>
          {% endfor %}
        </div>
      {% else %}
        <div class="ai-sticky-collage__empty-state-{{ ai_gen_id }}">
          Select a collection to display products
        </div>
      {% endif %}
    </div>
  </div>
</sticky-collage-{{ ai_gen_id }}>

<script>
  (function() {
    class StickyCollage{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.setupEventListeners();
        this.autoMatchImageHeight();
        window.addEventListener('resize', () => this.autoMatchImageHeight());
      }

      autoMatchImageHeight() {
        const manualControl = {{ block.settings.manual_height_control | json }};
        
        if (!manualControl) {
          const productsGrid = this.querySelector('[data-products-grid]');
          const stickyImage = this.querySelector('[data-sticky-image]');
          
          if (productsGrid && stickyImage && window.innerWidth > 749) {
            const productCards = Array.from(productsGrid.children).slice(0, 4);
            
            if (productCards.length >= 2) {
              const firstCard = productCards[0];
              const secondRowCard = productCards[2] || productCards[1];
              
              const firstCardRect = firstCard.getBoundingClientRect();
              const secondRowCardRect = secondRowCard.getBoundingClientRect();
              
              const twoRowsHeight = secondRowCardRect.bottom - firstCardRect.top;
              
              const imageWrapper = stickyImage.querySelector('.ai-sticky-collage__image-wrapper-{{ ai_gen_id }}');
              if (imageWrapper) {
                imageWrapper.style.height = twoRowsHeight + 'px';
              }
            }
          }
        }
      }

      setupEventListeners() {
        const selectButtons = this.querySelectorAll('.ai-sticky-collage__select-options-btn-{{ ai_gen_id }}');
        const wishlistButtons = this.querySelectorAll('.ai-sticky-collage__action-btn-{{ ai_gen_id }}');

        selectButtons.forEach((button) => {
          button.addEventListener('click', (e) => {
            e.preventDefault();
            e.stopPropagation();
            const productLink = button.closest('.ai-sticky-collage__product-card-{{ ai_gen_id }}').querySelector('.ai-sticky-collage__product-link-{{ ai_gen_id }}');
            if (productLink) {
              window.location.href = productLink.href;
            }
          });
        });

        wishlistButtons.forEach((button) => {
          button.addEventListener('click', (e) => {
            e.preventDefault();
            e.stopPropagation();
          });
        });
      }
    }

    customElements.define('sticky-collage-{{ ai_gen_id }}', StickyCollage{{ ai_gen_id }});
  })();
</script>

{% schema %}
{
  "name": "Sticky collection collage",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "Section header"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "Featured collection"
    },
    {
      "type": "inline_richtext",
      "id": "description",
      "label": "Description",
      "default": "Explore our curated selection of premium products"
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Heading size",
      "min": 20,
      "max": 60,
      "step": 2,
      "unit": "px",
      "default": 32
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#121212"
    },
    {
      "type": "range",
      "id": "heading_bottom_spacing",
      "label": "Space below heading",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 12
    },
    {
      "type": "range",
      "id": "description_size",
      "label": "Description size",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "color",
      "id": "description_color",
      "label": "Description color",
      "default": "#666666"
    },
    {
      "type": "range",
      "id": "header_spacing",
      "label": "Space below header",
      "min": 20,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 40
    },
    {
      "type": "header",
      "content": "Left image"
    },
    {
      "type": "image_picker",
      "id": "featured_image",
      "label": "Image"
    },
    {
      "type": "range",
      "id": "image_width",
      "label": "Image width",
      "min": 20,
      "max": 60,
      "step": 5,
      "unit": "%",
      "default": 35
    },
    {
      "type": "checkbox",
      "id": "manual_height_control",
      "label": "Manual height control",
      "default": false,
      "info": "Enable to manually set image height, disable for auto-match with products"
    },
    {
      "type": "range",
      "id": "image_height",
      "label": "Image height",
      "min": 300,
      "max": 1200,
      "step": 50,
      "unit": "px",
      "default": 600,
      "info": "Only applies when manual height control is enabled"
    },
    {
      "type": "range",
      "id": "image_border_radius",
      "label": "Image border radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 0
    },
    {
      "type": "header",
      "content": "Sticky behavior"
    },
    {
      "type": "checkbox",
      "id": "enable_sticky",
      "label": "Enable sticky image",
      "default": true
    },
    {
      "type": "range",
      "id": "sticky_top_offset",
      "label": "Sticky top offset",
      "min": 0,
      "max": 200,
      "step": 10,
      "unit": "px",
      "default": 20
    },
    {
      "type": "header",
      "content": "Products collection"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "products_limit",
      "label": "Products to show",
      "min": 2,
      "max": 20,
      "step": 2,
      "default": 8
    },
    {
      "type": "checkbox",
      "id": "enable_products_scroll",
      "label": "Enable independent scroll",
      "default": true,
      "info": "Products will scroll independently while image stays fixed"
    },
    {
      "type": "range",
      "id": "products_scroll_height",
      "label": "Products scroll height",
      "min": 400,
      "max": 1200,
      "step": 50,
      "unit": "px",
      "default": 700,
      "info": "Only applies when independent scroll is enabled"
    },
    {
      "type": "select",
      "id": "mobile_columns",
      "label": "Mobile columns",
      "options": [
        {
          "value": "1",
          "label": "1"
        },
        {
          "value": "2",
          "label": "2"
        }
      ],
      "default": "1"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "gap",
      "label": "Gap between columns",
      "min": 10,
      "max": 80,
      "step": 5,
      "unit": "px",
      "default": 30
    },
    {
      "type": "range",
      "id": "product_gap",
      "label": "Gap between products",
      "min": 8,
      "max": 40,
      "step": 2,
      "unit": "px",
