{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-review-grid-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    padding: 40px 20px;
  }

  .ai-review-grid-container-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat({{ block.settings.columns_desktop }}, 1fr);
    gap: 24px;
  }

  .ai-review-card-{{ ai_gen_id }} {
    background-color: {{ block.settings.card_background_color }};
    border-radius: {{ block.settings.card_border_radius }}px;
    padding: 24px;
    display: flex;
    flex-direction: column;
    gap: 16px;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
    transition: transform 0.3s ease;
  }

  .ai-review-card-{{ ai_gen_id }}:hover {
    transform: translateY(-4px);
  }

  .ai-review-header-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .ai-review-image-{{ ai_gen_id }} {
    width: 50px;
    height: 50px;
    border-radius: 50%;
    overflow: hidden;
    flex-shrink: 0;
  }

  .ai-review-image-{{ ai_gen_id }} img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-review-image-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-review-image-placeholder-{{ ai_gen_id }} svg {
    width: 60%;
    height: 60%;
  }

  .ai-review-info-{{ ai_gen_id }} {
    flex-grow: 1;
  }

  .ai-review-name-{{ ai_gen_id }} {
    font-size: 16px;
    font-weight: 600;
    color: {{ block.settings.text_color }};
    margin: 0 0 4px 0;
  }

  .ai-review-rating-{{ ai_gen_id }} {
    display: flex;
    gap: 2px;
  }

  .ai-review-star-{{ ai_gen_id }} {
    width: 16px;
    height: 16px;
    fill: {{ block.settings.star_color }};
  }

  .ai-review-star-empty-{{ ai_gen_id }} {
    fill: #e0e0e0;
  }

  .ai-review-text-{{ ai_gen_id }} {
    font-size: 14px;
    line-height: 1.6;
    color: {{ block.settings.text_color }};
  }

  .ai-review-product-link-{{ ai_gen_id }} {
    margin-top: auto;
    padding-top: 16px;
    border-top: 1px solid rgba(0, 0, 0, 0.1);
  }

  .ai-review-product-link-{{ ai_gen_id }} a {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 14px;
    font-weight: 600;
    color: {{ block.settings.link_color }};
    text-decoration: none;
    transition: color 0.3s ease;
  }

  .ai-review-product-link-{{ ai_gen_id }} a:hover {
    color: {{ block.settings.link_hover_color }};
  }

  .ai-review-product-link-{{ ai_gen_id }} svg {
    width: 16px;
    height: 16px;
    stroke: currentColor;
  }

  .ai-review-empty-state-{{ ai_gen_id }} {
    text-align: center;
    padding: 40px 20px;
    color: #999;
    font-style: italic;
  }

  @media screen and (max-width: 989px) {
    .ai-review-grid-container-{{ ai_gen_id }} {
      grid-template-columns: repeat({{ block.settings.columns_tablet }}, 1fr);
      gap: 20px;
    }
  }

  @media screen and (max-width: 749px) {
    .ai-review-grid-container-{{ ai_gen_id }} {
      grid-template-columns: repeat({{ block.settings.columns_mobile }}, 1fr);
      gap: 16px;
    }

    .ai-review-card-{{ ai_gen_id }} {
      padding: 20px;
    }
  }
{% endstyle %}

<product-reviews-{{ ai_gen_id }} class="ai-review-grid-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-review-grid-container-{{ ai_gen_id }}">
    {% for i in (1..9) %}
      {% liquid
        assign review_enabled_key = 'review_' | append: i | append: '_enabled'
        assign review_name_key = 'review_' | append: i | append: '_name'
        assign review_image_key = 'review_' | append: i | append: '_image'
        assign review_rating_key = 'review_' | append: i | append: '_rating'
        assign review_text_key = 'review_' | append: i | append: '_text'
        assign review_product_key = 'review_' | append: i | append: '_product'

        assign review_enabled = block.settings[review_enabled_key]
        assign review_name = block.settings[review_name_key]
        assign review_image = block.settings[review_image_key]
        assign review_rating = block.settings[review_rating_key]
        assign review_text = block.settings[review_text_key]
        assign review_product = block.settings[review_product_key]
      %}

      {% if review_enabled %}
        <div class="ai-review-card-{{ ai_gen_id }}">
          <div class="ai-review-header-{{ ai_gen_id }}">
            <div class="ai-review-image-{{ ai_gen_id }}">
              {% if review_image %}
                <img
                  src="{{ review_image | image_url: width: 100 }}"
                  alt="{{ review_name | escape }}"
                  width="100"
                  height="100"
                  loading="lazy"
                >
              {% else %}
                <div class="ai-review-image-placeholder-{{ ai_gen_id }}">
                  {{ 'image' | placeholder_svg_tag }}
                </div>
              {% endif %}
            </div>
            <div class="ai-review-info-{{ ai_gen_id }}">
              <h3 class="ai-review-name-{{ ai_gen_id }}">{{ review_name }}</h3>
              <div class="ai-review-rating-{{ ai_gen_id }}">
                {% for star in (1..5) %}
                  {% if star <= review_rating %}
                    <svg class="ai-review-star-{{ ai_gen_id }}" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
                      <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
                    </svg>
                  {% else %}
                    <svg class="ai-review-star-{{ ai_gen_id }} ai-review-star-empty-{{ ai_gen_id }}" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
                      <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
                    </svg>
                  {% endif %}
                {% endfor %}
              </div>
            </div>
          </div>
          <div class="ai-review-text-{{ ai_gen_id }}">
            {{ review_text }}
          </div>
          {% if review_product != blank %}
            <div class="ai-review-product-link-{{ ai_gen_id }}">
              <a href="{{ review_product.url }}">
                View {{ review_product.title }}
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/>
                </svg>
              </a>
            </div>
          {% endif %}
        </div>
      {% endif %}
    {% endfor %}
  </div>

  {% assign has_enabled_reviews = false %}
  {% for i in (1..9) %}
    {% liquid
      assign review_enabled_key = 'review_' | append: i | append: '_enabled'
      assign review_enabled = block.settings[review_enabled_key]
    %}
    {% if review_enabled %}
      {% assign has_enabled_reviews = true %}
      {% break %}
    {% endif %}
  {% endfor %}

  {% unless has_enabled_reviews %}
    <div class="ai-review-empty-state-{{ ai_gen_id }}">
      Next, enable and configure reviews
    </div>
  {% endunless %}
</product-reviews-{{ ai_gen_id }}>

<script>
  (function() {
    class ProductReviews{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
      }
    }

    customElements.define('product-reviews-{{ ai_gen_id }}', ProductReviews{{ ai_gen_id }});
  })();
</script>

