{% doc %}
  @prompt
    Create a newsletter subscription section for the footer area with a centered email input field (placeholder text: "Enter your email") and a "Subscribe Now" button next to it. The design should be clean and modern, matching a bedding/home goods store aesthetic. The section should have a customizable background color, heading text, and subheading text. The subscribe button should have a contrasting color. On mobile, the input and button should stack vertically.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-newsletter-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    margin: 0 auto;
    padding: {{ block.settings.section_padding }}px 24px;
    background-color: {{ block.settings.background_color }};
    color: {{ block.settings.text_color }};
    text-align: center;
  }

  .ai-newsletter-{{ ai_gen_id }}__inner {
    width: 100%;
    max-width: 720px;
    margin: 0 auto;
  }

  .ai-newsletter-{{ ai_gen_id }}__heading {
    margin: 0 0 10px;
    color: {{ block.settings.text_color }};
    font-size: {{ block.settings.heading_size }}px;
    line-height: 1.2;
    letter-spacing: 0.01em;
  }

  .ai-newsletter-{{ ai_gen_id }}__subheading {
    max-width: 560px;
    margin: 0 auto 24px;
    color: {{ block.settings.text_color }};
    font-size: {{ block.settings.subheading_size }}px;
    line-height: 1.5;
  }

  .ai-newsletter-{{ ai_gen_id }}__form {
    width: 100%;
  }

  .ai-newsletter-{{ ai_gen_id }}__fields {
    display: flex;
    align-items: stretch;
    justify-content: center;
    gap: 10px;
    width: 100%;
  }

  .ai-newsletter-{{ ai_gen_id }}__input {
    min-width: 0;
    flex: 1 1 auto;
    min-height: 48px;
    padding: 12px 16px;
    border: 1px solid {{ block.settings.input_border_color }};
    border-radius: {{ block.settings.input_radius }}px;
    background-color: {{ block.settings.input_background_color }};
    color: {{ block.settings.input_text_color }};
    font: inherit;
    font-size: 15px;
  }

  .ai-newsletter-{{ ai_gen_id }}__input::placeholder {
    color: {{ block.settings.input_placeholder_color }};
    opacity: 1;
  }

  .ai-newsletter-{{ ai_gen_id }}__input:focus-visible,
  .ai-newsletter-{{ ai_gen_id }}__button:focus-visible {
    outline: 2px solid {{ block.settings.focus_color }};
    outline-offset: 2px;
  }

  .ai-newsletter-{{ ai_gen_id }}__button {
    flex: 0 0 auto;
    min-height: 48px;
    padding: 12px 24px;
    border: 1px solid {{ block.settings.button_color }};
    border-radius: {{ block.settings.button_radius }}px;
    background-color: {{ block.settings.button_color }};
    color: {{ block.settings.button_text_color }};
    font: inherit;
    font-size: 15px;
    font-weight: 600;
    cursor: pointer;
    transition: opacity 0.2s ease;
  }

  .ai-newsletter-{{ ai_gen_id }}__button:hover {
    opacity: 0.85;
  }

  .ai-newsletter-{{ ai_gen_id }}__message {
    margin: 14px 0 0;
    color: {{ block.settings.text_color }};
    font-size: 14px;
    line-height: 1.4;
  }

  .ai-newsletter-{{ ai_gen_id }}__message--error {
    color: {{ block.settings.error_color }};
  }

  @media screen and (max-width: 749px) {
    .ai-newsletter-{{ ai_gen_id }} {
      padding-right: 16px;
      padding-left: 16px;
    }

    .ai-newsletter-{{ ai_gen_id }}__fields {
      flex-direction: column;
    }

    .ai-newsletter-{{ ai_gen_id }}__input,
    .ai-newsletter-{{ ai_gen_id }}__button {
      width: 100%;
      flex-basis: auto;
    }
  }
{% endstyle %}

<div class="ai-newsletter-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-newsletter-{{ ai_gen_id }}__inner">
    {% if block.settings.heading != blank %}
      <h2 class="ai-newsletter-{{ ai_gen_id }}__heading">{{ block.settings.heading | escape }}</h2>
    {% endif %}

    {% if block.settings.subheading != blank %}
      <p class="ai-newsletter-{{ ai_gen_id }}__subheading">{{ block.settings.subheading | escape }}</p>
    {% endif %}

    <div class="ai-newsletter-{{ ai_gen_id }}__form">
      {% form 'customer' %}
        <input type="hidden" name="contact[tags]" value="newsletter">
        <div class="ai-newsletter-{{ ai_gen_id }}__fields">
          <label class="visually-hidden" for="ai-newsletter-email-{{ ai_gen_id }}">Email address</label>
          <input id="ai-newsletter-email-{{ ai_gen_id }}" class="ai-newsletter-{{ ai_gen_id }}__input" type="email" name="contact[email]" value="{{ form.email | escape }}" placeholder="Enter your email" autocomplete="email" autocorrect="off" autocapitalize="off" required aria-required="true">
          <button class="ai-newsletter-{{ ai_gen_id }}__button" type="submit">{{ block.settings.button_label | escape }}</button>
        </div>
        {% if form.errors %}
          <p class="ai-newsletter-{{ ai_gen_id }}__message ai-newsletter-{{ ai_gen_id }}__message--error" role="alert">{{ form.errors.messages.email }}</p>
        {% elsif form.posted_successfully? %}
          <p class="ai-newsletter-{{ ai_gen_id }}__message" role="status">{{ block.settings.success_message | escape }}</p>
        {% endif %}
      {% endform %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Newsletter signup",
  "settings": [
    {"type":"header","content":"Content"},
    {"type":"text","id":"heading","label":"Heading","default":"Stay in the comfort loop"},
    {"type":"textarea","id":"subheading","label":"Subheading","default":"Sign up for thoughtful updates, restful inspiration, and exclusive offers."},
    {"type":"text","id":"button_label","label":"Button label","default":"Subscribe Now"},
    {"type":"text","id":"success_message","label":"Success message","default":"Thanks for subscribing. Welcome to The Cloud Bedding."},
    {"type":"header","content":"Colors"},
    {"type":"color","id":"background_color","label":"Background","default":"#e7dada"},
    {"type":"color","id":"text_color","label":"Text","default":"#121212"},
    {"type":"color","id":"button_color","label":"Button","default":"#122833"},
    {"type":"color","id":"button_text_color","label":"Button text","default":"#ffffff"},
    {"type":"color","id":"input_background_color","label":"Input background","default":"#ffffff"},
    {"type":"color","id":"input_text_color","label":"Input text","default":"#121212"},
    {"type":"color","id":"input_placeholder_color","label":"Placeholder","default":"#5c5c5c"},
    {"type":"color","id":"input_border_color","label":"Input border","default":"#767676"},
    {"type":"color","id":"focus_color","label":"Focus outline","default":"#122833"},
    {"type":"color","id":"error_color","label":"Error message","default":"#b3261e"},
    {"type":"header","content":"Layout"},
    {"type":"range","id":"desktop_width_percent","label":"Desktop width","min":50,"max":100,"step":5,"unit":"%","default":100},
    {"type":"range","id":"section_padding","label":"Section padding","min":20,"max":100,"step":5,"unit":"px","default":55},
    {"type":"range","id":"heading_size","label":"Heading size","min":20,"max":48,"step":2,"unit":"px","default":32},
    {"type":"range","id":"subheading_size","label":"Subheading size","min":12,"max":22,"step":1,"unit":"px","default":16},
    {"type":"range","id":"input_radius","label":"Input corners","min":0,"max":24,"step":2,"unit":"px","default":0},
    {"type":"range","id":"button_radius","label":"Button corners","min":0,"max":24,"step":2,"unit":"px","default":0}
  ],
  "presets":[{"name":"Newsletter signup"}],
  "tag":null,
  "class":"newsletter-signup-block"
}
{% endschema %}