{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-multimedia-collage-{{ ai_gen_id }} {
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    display: block;
    background-color: {{ block.settings.background_color }};
    padding: {{ block.settings.section_padding }}px;
  }

  .ai-multimedia-collage__header-{{ ai_gen_id }} {
    text-align: {{ block.settings.heading_alignment }};
    margin-bottom: {{ block.settings.heading_spacing }}px;
  }

  .ai-multimedia-collage__heading-{{ ai_gen_id }} {
    font-size: {{ block.settings.heading_size }}px;
    color: {{ block.settings.heading_color }};
    margin: 0;
  }

  .ai-multimedia-collage__container-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: {% if block.settings.layout == 'image-left' %}1fr 1fr{% else %}1fr 1fr{% endif %};
    gap: {{ block.settings.grid_gap }}px;
    margin-top: {{ block.settings.grid_top_spacing }}px;
  }

  @media screen and (max-width: 749px) {
    .ai-multimedia-collage__container-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
    }
  }

  .ai-multimedia-collage__featured-{{ ai_gen_id }} {
    position: relative;
    overflow: hidden;
    border-radius: {{ block.settings.featured_border_radius }}px;
    {% if block.settings.layout == 'image-right' %}
      order: 2;
    {% endif %}
  }

  @media screen and (max-width: 749px) {
    .ai-multimedia-collage__featured-{{ ai_gen_id }} {
      order: 1;
    }
  }

  .ai-multimedia-collage__featured-wrapper-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    padding-bottom: {{ block.settings.featured_aspect_ratio }}%;
    overflow: hidden;
  }

  .ai-multimedia-collage__featured-image-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-multimedia-collage__featured-placeholder-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-multimedia-collage__featured-placeholder-{{ ai_gen_id }} svg {
    width: 60%;
    height: 60%;
    opacity: 0.3;
  }

  .ai-multimedia-collage__featured-video-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-multimedia-collage__products-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat({{ block.settings.product_columns }}, 1fr);
    gap: {{ block.settings.product_gap }}px;
    align-content: start;
    {% if block.settings.layout == 'image-right' %}
      order: 1;
    {% endif %}
  }

  @media screen and (max-width: 749px) {
    .ai-multimedia-collage__products-{{ ai_gen_id }} {
      grid-template-columns: repeat({{ block.settings.product_columns_mobile }}, 1fr);
      order: 2;
    }
  }

  .ai-multimedia-collage__product-item-{{ ai_gen_id }} {
    position: relative;
    overflow: hidden;
    border-radius: {{ block.settings.product_border_radius }}px;
    background-color: {{ block.settings.product_background }};
  }

  .ai-multimedia-collage__product-link-{{ ai_gen_id }} {
    display: block;
    text-decoration: none;
    color: inherit;
    transition: transform 0.3s ease;
  }

  .ai-multimedia-collage__product-link-{{ ai_gen_id }}:hover {
    transform: scale({{ block.settings.hover_scale }});
  }

  .ai-multimedia-collage__product-image-wrapper-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    padding-bottom: {{ block.settings.product_aspect_ratio }}%;
    overflow: hidden;
  }

  .ai-multimedia-collage__product-image-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-multimedia-collage__product-placeholder-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-multimedia-collage__product-placeholder-{{ ai_gen_id }} svg {
    width: 60%;
    height: 60%;
    opacity: 0.3;
  }

  .ai-multimedia-collage__product-video-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-multimedia-collage__product-content-{{ ai_gen_id }} {
    padding: {{ block.settings.content_padding }}px;
  }

  .ai-multimedia-collage__product-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.title_size }}px;
    color: {{ block.settings.title_color }};
    margin: 0 0 8px 0;
    font-weight: 600;
  }

  .ai-multimedia-collage__product-price-{{ ai_gen_id }} {
    font-size: {{ block.settings.price_size }}px;
    color: {{ block.settings.price_color }};
    margin: 0;
    font-weight: 500;
  }

  .ai-multimedia-collage__empty-state-{{ ai_gen_id }} {
    text-align: center;
    padding: 40px 20px;
    color: #666;
    font-size: 14px;
  }
{% endstyle %}

<multimedia-collage-{{ ai_gen_id }}
  class="ai-multimedia-collage-{{ ai_gen_id }}"
  {{ block.shopify_attributes }}
>
  {% if block.settings.heading != blank %}
    <div class="ai-multimedia-collage__header-{{ ai_gen_id }}">
      <h2 class="ai-multimedia-collage__heading-{{ ai_gen_id }}">{{ block.settings.heading }}</h2>
    </div>
  {% endif %}

  {% if block.settings.collection != blank %}
    <div class="ai-multimedia-collage__container-{{ ai_gen_id }}">
      <div class="ai-multimedia-collage__featured-{{ ai_gen_id }}">
        <div class="ai-multimedia-collage__featured-wrapper-{{ ai_gen_id }}">
          {% if block.settings.featured_image %}
            <img
              src="{{ block.settings.featured_image | image_url: width: 1200 }}"
              alt="{{ block.settings.featured_image.alt | escape }}"
              loading="lazy"
              width="1200"
              height="{{ 1200 | times: block.settings.featured_aspect_ratio | divided_by: 100 }}"
              class="ai-multimedia-collage__featured-image-{{ ai_gen_id }}"
            >
          {% elsif block.settings.featured_video %}
            <video
              class="ai-multimedia-collage__featured-video-{{ ai_gen_id }}"
              {% if block.settings.video_autoplay %}autoplay{% endif %}
              {% if block.settings.video_loop %}loop{% endif %}
              {% if block.settings.video_muted %}muted{% endif %}
              playsinline
            >
              {% if block.settings.featured_video.sources %}
                {% for source in block.settings.featured_video.sources %}
                  <source src="{{ source.url }}" type="{{ source.mime_type }}">
                {% endfor %}
              {% endif %}
            </video>
          {% else %}
            <div class="ai-multimedia-collage__featured-placeholder-{{ ai_gen_id }}">
              {{ 'collection-1' | placeholder_svg_tag }}
            </div>
          {% endif %}
        </div>
      </div>

      <div class="ai-multimedia-collage__products-{{ ai_gen_id }}">
        {% for product in block.settings.collection.products limit: block.settings.products_limit %}
          <div class="ai-multimedia-collage__product-item-{{ ai_gen_id }}">
            <a href="{{ product.url }}" class="ai-multimedia-collage__product-link-{{ ai_gen_id }}">
              <div class="ai-multimedia-collage__product-image-wrapper-{{ ai_gen_id }}">
                {% if product.featured_media %}
                  {% if product.featured_media.media_type == 'image' %}
                    <img
                      src="{{ product.featured_media | image_url: width: 600 }}"
                      alt="{{ product.featured_media.alt | escape }}"
                      loading="lazy"
                      width="600"
                      height="{{ 600 | times: block.settings.product_aspect_ratio | divided_by: 100 }}"
                      class="ai-multimedia-collage__product-image-{{ ai_gen_id }}"
                    >
                  {% elsif product.featured_media.media_type == 'video' or product.featured_media.media_type == 'external_video' %}
                    <video
                      class="ai-multimedia-collage__product-video-{{ ai_gen_id }}"
                      {% if block.settings.video_autoplay %}autoplay{% endif %}
                      {% if block.settings.video_loop %}loop{% endif %}
                      {% if block.settings.video_muted %}muted{% endif %}
                      playsinline
                    >
                      {% if product.featured_media.sources %}
                        {% for source in product.featured_media.sources %}
                          <source src="{{ source.url }}" type="{{ source.mime_type }}">
                        {% endfor %}
                      {% endif %}
                    </video>
                  {% endif %}
                {% else %}
                  <div class="ai-multimedia-collage__product-placeholder-{{ ai_gen_id }}">
                    {{ 'product-1' | placeholder_svg_tag }}
                  </div>
                {% endif %}
              </div>

              {% if block.settings.show_product_info %}
                <div class="ai-multimedia-collage__product-content-{{ ai_gen_id }}">
                  <h3 class="ai-multimedia-collage__product-title-{{ ai_gen_id }}">{{ product.title }}</h3>
                  <p class="ai-multimedia-collage__product-price-{{ ai_gen_id }}">{{ product.price | money }}</p>
                </div>
              {% endif %}
            </a>
          </div>
        {% endfor %}
      </div>
    </div>
  {% else %}
    <div class="ai-multimedia-collage__empty-state-{{ ai_gen_id }}">
      Please select a collection to display products
    </div>
  {% endif %}
</multimedia-collage-{{ ai_gen_id }}>

<script>
  (function() {
    class MultimediaCollage{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.videos = this.querySelectorAll('.ai-multimedia-collage__featured-video-{{ ai_gen_id }}, .ai-multimedia-collage__product-video-{{ ai_gen_id }}');
        this.setupVideoObserver();
      }

      setupVideoObserver() {
        if (!this.videos.length) return;

        const options = {
          root: null,
          rootMargin: '0px',
          threshold: 0.5
        };

        const observer = new IntersectionObserver((entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.play();
            } else {
              entry.target.pause();
            }
          });
        }, options);

        this.videos.forEach((video) => {
          observer.observe(video);
        });
      }
    }

    customElements.define('multimedia-collage-{{ ai_gen_id }}', MultimediaCollage{{ ai_gen_id }});
  })();
</script>

