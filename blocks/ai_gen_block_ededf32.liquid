{% doc %}
  @prompt
    Center align the "Cloud Collection" heading text that appears above the collection list section on the page. The heading should be displayed in the middle/center of the page horizontally., iska nichy ak subtitle ki line bhi add kro  or 3 cloum add kro jis ma mai 3 collection rakh sakon 
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-collection-showcase-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    margin: 0 auto;
    padding: {{ block.settings.padding_top }}px 20px {{ block.settings.padding_bottom }}px;
  }

  .ai-collection-showcase__header-{{ ai_gen_id }} {
    text-align: {{ block.settings.text_alignment }};
    margin-bottom: {{ block.settings.header_spacing }}px;
  }

  .ai-collection-showcase__title-{{ ai_gen_id }} {
    margin: 0 0 {{ block.settings.subtitle_spacing }}px;
    font-size: {{ block.settings.heading_size }}px;
    color: {{ block.settings.heading_color }};
    font-weight: {{ block.settings.heading_weight }};
    letter-spacing: {{ block.settings.letter_spacing }}px;
  }

  .ai-collection-showcase__subtitle-{{ ai_gen_id }} {
    margin: 0;
    font-size: {{ block.settings.subtitle_size }}px;
    color: {{ block.settings.subtitle_color }};
    font-weight: {{ block.settings.subtitle_weight }};
    line-height: 1.5;
  }

  .ai-collection-showcase__grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: {{ block.settings.grid_gap }}px;
  }

  .ai-collection-showcase__item-{{ ai_gen_id }} {
    position: relative;
    overflow: hidden;
    border-radius: {{ block.settings.card_radius }}px;
    background-color: {{ block.settings.card_background }};
  }

  .ai-collection-showcase__image-wrapper-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    padding-bottom: {{ block.settings.image_ratio }}%;
    overflow: hidden;
  }

  .ai-collection-showcase__image-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s ease;
  }

  .ai-collection-showcase__item-{{ ai_gen_id }}:hover .ai-collection-showcase__image-{{ ai_gen_id }} {
    transform: scale(1.05);
  }

  .ai-collection-showcase__placeholder-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-collection-showcase__placeholder-{{ ai_gen_id }} svg {
    width: 60%;
    height: 60%;
    opacity: 0.3;
  }

  .ai-collection-showcase__content-{{ ai_gen_id }} {
    padding: {{ block.settings.card_padding }}px;
    text-align: {{ block.settings.card_text_alignment }};
  }

  .ai-collection-showcase__collection-title-{{ ai_gen_id }} {
    margin: 0 0 8px;
    font-size: {{ block.settings.collection_title_size }}px;
    color: {{ block.settings.collection_title_color }};
    font-weight: 600;
  }

  .ai-collection-showcase__collection-link-{{ ai_gen_id }} {
    display: inline-block;
    text-decoration: none;
    color: inherit;
  }

  .ai-collection-showcase__collection-count-{{ ai_gen_id }} {
    font-size: {{ block.settings.collection_count_size }}px;
    color: {{ block.settings.collection_count_color }};
  }

  .ai-collection-showcase__empty-state-{{ ai_gen_id }} {
    padding: 20px;
    text-align: center;
    color: #999;
    font-style: italic;
  }

  @media screen and (max-width: 989px) {
    .ai-collection-showcase__grid-{{ ai_gen_id }} {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media screen and (max-width: 749px) {
    .ai-collection-showcase__title-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.heading_size }}px * 0.8);
    }

    .ai-collection-showcase__subtitle-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.subtitle_size }}px * 0.9);
    }

    .ai-collection-showcase__grid-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
    }
  }
{% endstyle %}

<div class="ai-collection-showcase-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-collection-showcase__header-{{ ai_gen_id }}">
    {% if block.settings.heading != blank %}
      <h2 class="ai-collection-showcase__title-{{ ai_gen_id }}">
        {{ block.settings.heading }}
      </h2>
    {% endif %}
    
    {% if block.settings.subtitle != blank %}
      <p class="ai-collection-showcase__subtitle-{{ ai_gen_id }}">
        {{ block.settings.subtitle }}
      </p>
    {% endif %}
  </div>

  <div class="ai-collection-showcase__grid-{{ ai_gen_id }}">
    {% for i in (1..3) %}
      {% liquid
        assign collection_key = 'collection_' | append: i
        assign collection = block.settings[collection_key]
      %}
      
      <div class="ai-collection-showcase__item-{{ ai_gen_id }}">
        {% if collection != blank %}
          <a href="{{ collection.url }}" class="ai-collection-showcase__collection-link-{{ ai_gen_id }}">
            <div class="ai-collection-showcase__image-wrapper-{{ ai_gen_id }}">
              {% if collection.featured_image %}
                <img
                  src="{{ collection.featured_image | image_url: width: 600 }}"
                  alt="{{ collection.featured_image.alt | escape }}"
                  loading="lazy"
                  width="600"
                  height="{{ 600 | times: block.settings.image_ratio | divided_by: 100 }}"
                  class="ai-collection-showcase__image-{{ ai_gen_id }}"
                >
              {% else %}
                <div class="ai-collection-showcase__placeholder-{{ ai_gen_id }}">
                  {{ 'collection-1' | placeholder_svg_tag }}
                </div>
              {% endif %}
            </div>
            
            <div class="ai-collection-showcase__content-{{ ai_gen_id }}">
              <h3 class="ai-collection-showcase__collection-title-{{ ai_gen_id }}">
                {{ collection.title }}
              </h3>
              {% if block.settings.show_product_count %}
                <p class="ai-collection-showcase__collection-count-{{ ai_gen_id }}">
                  {{ collection.products_count }} 
                  {% if collection.products_count == 1 %}
                    product
                  {% else %}
                    products
                  {% endif %}
                </p>
              {% endif %}
            </div>
          </a>
        {% else %}
          <div class="ai-collection-showcase__image-wrapper-{{ ai_gen_id }}">
            <div class="ai-collection-showcase__placeholder-{{ ai_gen_id }}">
              {{ 'collection-1' | placeholder_svg_tag }}
            </div>
          </div>
          <div class="ai-collection-showcase__content-{{ ai_gen_id }}">
            <div class="ai-collection-showcase__empty-state-{{ ai_gen_id }}">
              Select collection {{ i }}
            </div>
          </div>
        {% endif %}
      </div>
    {% endfor %}
  </div>
</div>

