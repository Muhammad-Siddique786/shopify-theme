<section class="advanced-showcase">

  <div class="advanced-showcase__container">

    {% if section.settings.heading != blank %}
      <h2 class="advanced-showcase__heading">
        {{ section.settings.heading }}
      </h2>
    {% endif %}


    {% if section.settings.description != blank %}
      <div class="advanced-showcase__description">
        {{ section.settings.description }}
      </div>
    {% endif %}


    <!-- Selected Product -->

    {% if section.settings.product != blank %}

      <div class="advanced-showcase__product">

        <div class="advanced-showcase__product-image">

          {% if section.settings.product.featured_image != blank %}

            {{
              section.settings.product.featured_image
              | image_url: width: 700
              | image_tag: loading: 'lazy'
            }}

          {% endif %}

        </div>


        <div class="advanced-showcase__product-info">

          <h3>
            {{ section.settings.product.title }}
          </h3>

          <p>
            {{ section.settings.product.price | money }}
          </p>

          <a
            href="{{ section.settings.product.url }}"
            class="advanced-showcase__button"
          >
            View Product
          </a>

        </div>

      </div>

    {% endif %}


    <!-- Selected Collection -->

    {% if section.settings.collection != blank %}

      <div class="advanced-showcase__collection">

        <h3>
          {{ section.settings.collection.title }}
        </h3>


        <div class="advanced-showcase__products">

          {% for product in section.settings.collection.products limit: 4 %}

            {% render 'product-card', product: product %}

          {% endfor %}

        </div>

      </div>

    {% endif %}


    <!-- Dynamic Blocks -->

    {% if section.blocks.size > 0 %}

      <div class="advanced-showcase__blocks">

        {% for block in section.blocks %}

          <div
            class="advanced-showcase__block"
            {{ block.shopify_attributes }}
          >

            {% if block.settings.image != blank %}

              <div class="advanced-showcase__block-image">

                {{
                  block.settings.image
                  | image_url: width: 400
                  | image_tag: loading: 'lazy'
                }}

              </div>

            {% endif %}


            {% if block.settings.heading != blank %}

              <h4>
                {{ block.settings.heading }}
              </h4>

            {% endif %}


            {% if block.settings.text != blank %}

              <p>
                {{ block.settings.text }}
              </p>

            {% endif %}

          </div>

        {% endfor %}

      </div>

    {% endif %}

  </div>

</section>


<style>

.advanced-showcase {
  padding: 60px 20px;
}

.advanced-showcase__container {
  max-width: 1200px;
  margin: 0 auto;
}

.advanced-showcase__heading {
  text-align: center;
  margin: 0 0 15px;
}

.advanced-showcase__description {
  max-width: 700px;
  margin: 0 auto 40px;
  text-align: center;
}


/* Product */

.advanced-showcase__product {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 40px;
  align-items: center;
  margin-bottom: 60px;
}

.advanced-showcase__product-image img {
  width: 100%;
  display: block;
}

.advanced-showcase__product-info h3 {
  font-size: 28px;
  margin-bottom: 15px;
}

.advanced-showcase__product-info p {
  font-size: 20px;
  margin-bottom: 20px;
}


/* Button */

.advanced-showcase__button {
  display: inline-block;
  padding: 12px 24px;
  background: #111;
  color: #fff;
  text-decoration: none;
  border-radius: 4px;
}


/* Collection */

.advanced-showcase__collection {
  margin-bottom: 60px;
}

.advanced-showcase__collection > h3 {
  text-align: center;
  margin-bottom: 30px;
}

.advanced-showcase__products {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 24px;
}


/* Blocks */

.advanced-showcase__blocks {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 24px;
}

.advanced-showcase__block {
  text-align: center;
  padding: 25px;
  border: 1px solid #e5e5e5;
  border-radius: 8px;
}

.advanced-showcase__block-image img {
  width: 100%;
  height: auto;
  display: block;
  margin-bottom: 20px;
}

.advanced-showcase__block h4 {
  margin-bottom: 10px;
}


/* Tablet */

@media screen and (max-width: 989px) {

  .advanced-showcase__products {
    grid-template-columns: repeat(2, 1fr);
  }

  .advanced-showcase__blocks {
    grid-template-columns: repeat(2, 1fr);
  }

}


/* Mobile */

@media screen and (max-width: 749px) {

  .advanced-showcase__product {
    grid-template-columns: 1fr;
    gap: 25px;
  }

  .advanced-showcase__products {
    grid-template-columns: 1fr;
  }

  .advanced-showcase__blocks {
    grid-template-columns: 1fr;
  }

}

</style>


{% schema %}
{
  "name": "Advanced Showcase",

  "settings": [

    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Featured Collection"
    },

    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>Explore our featured products and collections.</p>"
    },

    {
      "type": "product",
      "id": "product",
      "label": "Select Product"
    },

    {
      "type": "collection",
      "id": "collection",
      "label": "Select Collection"
    }

  ],


  "blocks": [

    {
      "type": "feature",
      "name": "Feature",

      "settings": [

        {
          "type": "image_picker",
          "id": "image",
          "label": "Feature Image"
        },

        {
          "type": "text",
          "id": "heading",
          "label": "Feature Heading",
          "default": "Why Choose Us?"
        },

        {
          "type": "textarea",
          "id": "text",
          "label": "Feature Text",
          "default": "Add your feature description here."
        }

      ]

    }

  ],


  "presets": [

    {
      "name": "Advanced Showcase",

      "blocks": [
        {
          "type": "feature"
        },
        {
          "type": "feature"
        },
        {
          "type": "feature"
        }
      ]
    }

  ]

}
{% endschema %}