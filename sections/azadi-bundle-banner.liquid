<div
  id="AzadiBundle-{{ section.id }}"
  class="azadi-bundle"
>
  <div class="azadi-bundle__inner">

    <!-- LEFT IMAGE -->
    <div class="azadi-bundle__image">
      {% if section.settings.image != blank %}
        {{
          section.settings.image
          | image_url: width: 1000
          | image_tag:
            loading: 'lazy',
            class: 'azadi-bundle__img'
        }}
      {% endif %}
    </div>

    <!-- CONTENT -->
    <div class="azadi-bundle__content">

      <div class="azadi-bundle__small-title">
        {{ section.settings.small_title }}
      </div>

      <h2 class="azadi-bundle__title">
        {{ section.settings.heading }}
        {% if section.settings.heading_small != blank %}
          <span>{{ section.settings.heading_small }}</span>
        {% endif %}
      </h2>

      <div class="azadi-bundle__description">
        {{ section.settings.description }}
      </div>

    </div>

    <!-- DISCOUNTS -->
    <div class="azadi-bundle__discount-area">

      <div class="azadi-bundle__combine">
        {{ section.settings.combine_text }}
      </div>

      <div class="azadi-bundle__discounts">

        <div class="azadi-bundle__discount">
          <div class="azadi-bundle__discount-label">
            {{ section.settings.discount_1_label }}
          </div>
          <div class="azadi-bundle__discount-value">
            {{ section.settings.discount_1_value }}
          </div>
        </div>

        <div class="azadi-bundle__discount">
          <div class="azadi-bundle__discount-label">
            {{ section.settings.discount_2_label }}
          </div>
          <div class="azadi-bundle__discount-value">
            {{ section.settings.discount_2_value }}
          </div>
        </div>

        <div class="azadi-bundle__discount azadi-bundle__discount--total">
          <div class="azadi-bundle__discount-label">
            {{ section.settings.discount_3_label }}
          </div>
          <div class="azadi-bundle__discount-value">
            {{ section.settings.discount_3_value }}
          </div>
        </div>

      </div>

    </div>

    <!-- BUTTON -->
    <div class="azadi-bundle__button-wrapper">

      {% if section.settings.button_link != blank %}
        <a
          href="{{ section.settings.button_link }}"
          class="azadi-bundle__button"
        >
          <span>
            {{ section.settings.button_text }}
          </span>

          <span class="azadi-bundle__arrow">
            →
          </span>
        </a>
      {% else %}
        <div class="azadi-bundle__button">
          <span>
            {{ section.settings.button_text }}
          </span>

          <span class="azadi-bundle__arrow">
            →
          </span>
        </div>
      {% endif %}

    </div>

  </div>
</div>


<style>

  #AzadiBundle-{{ section.id }} {
    width: 100%;
    padding: 30px 0;
  }

  #AzadiBundle-{{ section.id }} .azadi-bundle__inner {
    width: calc(100% - 70px);
    max-width: 1280px;
    margin: 0 auto;

    min-height: 190px;

    display: flex;
    align-items: center;

    background: #034d3d;

    border: 2px solid #d9b45b;
    border-radius: 20px;

    overflow: hidden;

    box-shadow: 0 12px 30px rgba(0, 0, 0, 0.12);
  }

  /* LEFT IMAGE */

  #AzadiBundle-{{ section.id }} .azadi-bundle__image {
    width: 23%;
    min-height: 190px;

    display: flex;
    align-items: flex-end;
    justify-content: center;

    border-right: 2px solid #d9b45b;

    overflow: hidden;
  }

  #AzadiBundle-{{ section.id }} .azadi-bundle__img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  /* CONTENT */

  #AzadiBundle-{{ section.id }} .azadi-bundle__content {
    width: 29%;
    padding: 25px 18px;
  }

  #AzadiBundle-{{ section.id }} .azadi-bundle__small-title {
    font-size: 13px;
    font-weight: 700;
    color: #ffffff;

    text-transform: uppercase;

    margin-bottom: 2px;
  }

  #AzadiBundle-{{ section.id }} .azadi-bundle__title {
    margin: 0 0 8px;

    font-size: 31px;
    line-height: 1;

    font-weight: 800;

    color: #e0b85f;

    text-transform: uppercase;
  }

  #AzadiBundle-{{ section.id }} .azadi-bundle__title span {
    font-size: 14px;
    vertical-align: middle;
    color: #e0b85f;
  }

  #AzadiBundle-{{ section.id }} .azadi-bundle__description {
    color: #ffffff;

    font-size: 14px;
    line-height: 1.4;

    max-width: 360px;
  }

  /* DISCOUNTS */

  #AzadiBundle-{{ section.id }} .azadi-bundle__discount-area {
    width: 32%;
    padding: 10px;
  }

  #AzadiBundle-{{ section.id }} .azadi-bundle__combine {
    text-align: center;

    color: #e0b85f;

    font-size: 13px;
    font-weight: 700;

    margin-bottom: 7px;
  }

  #AzadiBundle-{{ section.id }} .azadi-bundle__discounts {
    display: flex;

    border: 1px solid #d9b45b;
    border-radius: 10px;

    overflow: hidden;
  }

  #AzadiBundle-{{ section.id }} .azadi-bundle__discount {
    flex: 1;

    text-align: center;

    padding: 9px 7px;

    border-right: 1px solid #d9b45b;
  }

  #AzadiBundle-{{ section.id }} .azadi-bundle__discount:last-child {
    border-right: 0;
  }

  #AzadiBundle-{{ section.id }} .azadi-bundle__discount-label {
    color: #ffffff;

    font-size: 10px;
    font-weight: 600;

    margin-bottom: 3px;
  }

  #AzadiBundle-{{ section.id }} .azadi-bundle__discount-value {
    color: #e0b85f;

    font-size: 20px;
    line-height: 1;

    font-weight: 800;
  }

  /* BUTTON */

  #AzadiBundle-{{ section.id }} .azadi-bundle__button-wrapper {
    width: 16%;
    padding: 15px;
  }

  #AzadiBundle-{{ section.id }} .azadi-bundle__button {
    min-height: 50px;

    display: flex;
    align-items: center;
    justify-content: center;
    gap: 15px;

    padding: 10px 15px;

    background: #dfba65;

    color: #063f34;

    border-radius: 8px;

    text-decoration: none;

    font-size: 11px;
    font-weight: 800;

    text-transform: uppercase;

    cursor: pointer;

    transition: all 0.25s ease;
  }

  #AzadiBundle-{{ section.id }} .azadi-bundle__button:hover {
    transform: translateY(-2px);
    opacity: 0.9;
  }

  #AzadiBundle-{{ section.id }} .azadi-bundle__arrow {
    font-size: 18px;
    line-height: 1;
  }


  /* MOBILE */

  @media screen and (max-width: 749px) {

    #AzadiBundle-{{ section.id }} {
      padding: 15px 0;
    }

    #AzadiBundle-{{ section.id }} .azadi-bundle__inner {
      width: calc(100% - 24px);

      display: grid;

      grid-template-columns: 40% 60%;

      min-height: auto;

      border-radius: 14px;
    }

    #AzadiBundle-{{ section.id }} .azadi-bundle__image {
      width: 100%;
      min-height: 150px;

      grid-row: span 2;

      border-right: 1px solid #e09523ff;
    }

    #AzadiBundle-{{ section.id }} .azadi-bundle__content {
      width: auto;

      padding: 18px 12px 5px;
    }

    #AzadiBundle-{{ section.id }} .azadi-bundle__small-title {
      font-size: 12px;
    }

    #AzadiBundle-{{ section.id }} .azadi-bundle__title {
      font-size: 20px;
    }

    #AzadiBundle-{{ section.id }} .azadi-bundle__title span {
      font-size: 10px;
    }

    #AzadiBundle-{{ section.id }} .azadi-bundle__description {
      font-size: 10px;
    }

    #AzadiBundle-{{ section.id }} .azadi-bundle__discount-area {
      width: auto;

      padding: 5px 8px 12px;
    }

    #AzadiBundle-{{ section.id }} .azadi-bundle__combine {
      font-size: 9px;
    }

    #AzadiBundle-{{ section.id }} .azadi-bundle__discount {
      padding: 6px 3px;
    }

    #AzadiBundle-{{ section.id }} .azadi-bundle__discount-label {
      font-size: 7px;
    }

    #AzadiBundle-{{ section.id }} .azadi-bundle__discount-value {
      font-size: 13px;
    }

    #AzadiBundle-{{ section.id }} .azadi-bundle__button-wrapper {
      width: auto;

      grid-column: 1 / -1;

      padding: 0 10px 10px;
    }

    #AzadiBundle-{{ section.id }} .azadi-bundle__button {
      min-height: 40px;

      font-size: 9px;
    }

  }

</style>


{% schema %}
{
  "name": "Azadi Bundle Banner",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Banner Image"
    },
    {
      "type": "text",
      "id": "small_title",
      "label": "Small Title",
      "default": "BUILD YOUR"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Main Heading",
      "default": "AZAADI BUNDLE"
    },
    {
      "type": "text",
      "id": "heading_small",
      "label": "Heading Small Text",
      "default": "PK"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Get 9% OFF on your bundle and an extra 5% OFF with advance payment."
    },
    {
      "type": "text",
      "id": "combine_text",
      "label": "Combine Text",
      "default": "Combine Your Savings"
    },
    {
      "type": "text",
      "id": "discount_1_label",
      "label": "Discount 1 Label",
      "default": "Bundle Discount"
    },
    {
      "type": "text",
      "id": "discount_1_value",
      "label": "Discount 1 Value",
      "default": "9% OFF"
    },
    {
      "type": "text",
      "id": "discount_2_label",
      "label": "Discount 2 Label",
      "default": "Advance Payment"
    },
    {
      "type": "text",
      "id": "discount_2_value",
      "label": "Discount 2 Value",
      "default": "+5% OFF"
    },
    {
      "type": "text",
      "id": "discount_3_label",
      "label": "Discount 3 Label",
      "default": "Total Savings"
    },
    {
      "type": "text",
      "id": "discount_3_value",
      "label": "Discount 3 Value",
      "default": "UP TO 14%"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Text",
      "default": "BUILD YOUR BUNDLE"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    }
  ],
  "presets": [
    {
      "name": "Azadi Bundle Banner"
    }
  ]
}
{% endschema %}