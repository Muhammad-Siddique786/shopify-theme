{%- style -%}

  .custom-liquid-pro-{{ section.id }} {
    width: 100%;
    position: relative;
    overflow: hidden;
  }

  .custom-liquid-pro-{{ section.id }} .custom-liquid-pro__inner {
    width: 100%;
    max-width: {{ section.settings.max_width }}px;
    margin: 0 auto;

    {% if section.settings.height_mode == 'custom' %}
      min-height: {{ section.settings.desktop_height }}px;
    {% endif %}

    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;

    padding-left: 30px;
    padding-right: 30px;

    display: flex;
    flex-direction: column;
    justify-content: center;

    text-align: {{ section.settings.text_alignment }};
  }

  /* Content */

  .custom-liquid-pro-{{ section.id }} .custom-liquid-pro__content {
    width: 100%;
    overflow: hidden;
  }

  /* Statements */

  .custom-liquid-pro-{{ section.id }} .custom-liquid-pro__statements {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 25px;
    margin-bottom: 25px;
    flex-wrap: wrap;
  }

  .custom-liquid-pro-{{ section.id }} .custom-liquid-pro__statement {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    font-size: 14px;
    line-height: 1.4;
    font-weight: 500;
    white-space: nowrap;
  }

  .custom-liquid-pro-{{ section.id }} .custom-liquid-pro__icon {
    font-size: 18px;
    line-height: 1;
  }

  /* Card */

  {% if section.settings.enable_card %}

    .custom-liquid-pro-{{ section.id }} .custom-liquid-pro__inner {
      border-radius: {{ section.settings.border_radius }}px;
      background: {{ section.settings.card_background }};
      box-shadow: 0 8px 30px rgba(0, 0, 0, 0.06);
    }

  {% endif %}

  /* Divider */

  {% if section.settings.show_divider %}

    .custom-liquid-pro-{{ section.id }} .custom-liquid-pro__divider {
      width: 100%;
      height: 1px;
      background: rgba(0, 0, 0, 0.12);
      margin: 5px 0 25px;
    }

  {% endif %}

  /* Desktop */

  @media screen and (min-width: 750px) {

    .custom-liquid-pro-{{ section.id }} .custom-liquid-pro__inner {
      padding-left: 40px;
      padding-right: 40px;

      {% if section.settings.height_mode == 'custom' %}
        min-height: {{ section.settings.desktop_height }}px;
      {% endif %}
    }

    .custom-liquid-pro-{{ section.id }} .custom-liquid-pro__statements {
      gap: 45px;
    }

    .custom-liquid-pro-{{ section.id }} .custom-liquid-pro__statement {
      font-size: {{ section.settings.statement_font_size }}px;
    }

  }

  /* Mobile */

  @media screen and (max-width: 749px) {

    .custom-liquid-pro-{{ section.id }} .custom-liquid-pro__inner {
      padding-left: 18px;
      padding-right: 18px;

      {% if section.settings.height_mode == 'custom' %}
        min-height: {{ section.settings.mobile_height }}px;
      {% endif %}

      {% if section.settings.enable_card %}
        border-radius: {{ section.settings.mobile_border_radius }}px;
      {% endif %}
    }

    .custom-liquid-pro-{{ section.id }} .custom-liquid-pro__statements {
      gap: 14px;
      flex-direction: column;
    }

    .custom-liquid-pro-{{ section.id }} .custom-liquid-pro__statement {
      font-size: {{ section.settings.mobile_statement_font_size }}px;
      white-space: normal;
      text-align: center;
    }

  }

{%- endstyle -%}


<div
  class="custom-liquid-pro-{{ section.id }} color-{{ section.settings.color_scheme }} gradient"
>

  <div class="custom-liquid-pro__inner">

    {% if section.settings.show_statements %}

      <div class="custom-liquid-pro__statements">

        {% if section.settings.statement_1 != blank %}
          <div class="custom-liquid-pro__statement">

            {% if section.settings.statement_1_icon != blank %}
              <span class="custom-liquid-pro__icon">
                {{ section.settings.statement_1_icon }}
              </span>
            {% endif %}

            <span>
              {{ section.settings.statement_1 }}
            </span>

          </div>
        {% endif %}


        {% if section.settings.statement_2 != blank %}
          <div class="custom-liquid-pro__statement">

            {% if section.settings.statement_2_icon != blank %}
              <span class="custom-liquid-pro__icon">
                {{ section.settings.statement_2_icon }}
              </span>
            {% endif %}

            <span>
              {{ section.settings.statement_2 }}
            </span>

          </div>
        {% endif %}


        {% if section.settings.statement_3 != blank %}
          <div class="custom-liquid-pro__statement">

            {% if section.settings.statement_3_icon != blank %}
              <span class="custom-liquid-pro__icon">
                {{ section.settings.statement_3_icon }}
              </span>
            {% endif %}

            <span>
              {{ section.settings.statement_3 }}
            </span>

          </div>
        {% endif %}

      </div>

    {% endif %}


    {% if section.settings.show_divider %}
      <div class="custom-liquid-pro__divider"></div>
    {% endif %}


    <div class="custom-liquid-pro__content">

      {{ section.settings.custom_liquid }}

    </div>

  </div>

</div>


{% schema %}

{
  "name": "Custom Liquid Pro",
  "tag": "section",
  "class": "section",

  "settings": [

    {
      "type": "liquid",
      "id": "custom_liquid",
      "label": "Custom Liquid",
      "info": "Add your custom Liquid, HTML, CSS or JavaScript here."
    },

    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },

    {
      "type": "range",
      "id": "max_width",
      "min": 600,
      "max": 1600,
      "step": 50,
      "unit": "px",
      "label": "Maximum content width",
      "default": 1200
    },


    {
      "type": "header",
      "content": "Height Settings"
    },

    {
      "type": "select",
      "id": "height_mode",
      "label": "Height mode",
      "options": [
        {
          "value": "auto",
          "label": "Auto height"
        },
        {
          "value": "custom",
          "label": "Custom height"
        }
      ],
      "default": "auto"
    },

    {
      "type": "range",
      "id": "desktop_height",
      "min": 100,
      "max": 900,
      "step": 10,
      "unit": "px",
      "label": "Desktop height",
      "default": 300
    },

    {
      "type": "range",
      "id": "mobile_height",
      "min": 100,
      "max": 700,
      "step": 10,
      "unit": "px",
      "label": "Mobile height",
      "default": 250
    },


    {
      "type": "header",
      "content": "Statements"
    },

    {
      "type": "checkbox",
      "id": "show_statements",
      "label": "Show statements",
      "default": true
    },

    {
      "type": "text",
      "id": "statement_1",
      "label": "Statement 1",
      "default": "Free Shipping on Orders"
    },

    {
      "type": "text",
      "id": "statement_1_icon",
      "label": "Statement 1 icon",
      "default": "🚚"
    },

    {
      "type": "text",
      "id": "statement_2",
      "label": "Statement 2",
      "default": "Premium Quality Products"
    },

    {
      "type": "text",
      "id": "statement_2_icon",
      "label": "Statement 2 icon",
      "default": "✓"
    },

    {
      "type": "text",
      "id": "statement_3",
      "label": "Statement 3",
      "default": "Secure & Easy Checkout"
    },

    {
      "type": "text",
      "id": "statement_3_icon",
      "label": "Statement 3 icon",
      "default": "🔒"
    },


    {
      "type": "range",
      "id": "statement_font_size",
      "min": 10,
      "max": 24,
      "step": 1,
      "unit": "px",
      "label": "Desktop statement size",
      "default": 14
    },

    {
      "type": "range",
      "id": "mobile_statement_font_size",
      "min": 10,
      "max": 20,
      "step": 1,
      "unit": "px",
      "label": "Mobile statement size",
      "default": 13
    },


    {
      "type": "checkbox",
      "id": "show_divider",
      "label": "Show divider",
      "default": false
    },


    {
      "type": "header",
      "content": "Card Design"
    },

    {
      "type": "checkbox",
      "id": "enable_card",
      "label": "Enable card styling",
      "default": false
    },

    {
      "type": "color",
      "id": "card_background",
      "label": "Card background",
      "default": "#ffffff"
    },

    {
      "type": "range",
      "id": "border_radius",
      "min": 0,
      "max": 50,
      "step": 2,
      "unit": "px",
      "label": "Desktop border radius",
      "default": 16
    },

    {
      "type": "range",
      "id": "mobile_border_radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "Mobile border radius",
      "default": 12
    },


    {
      "type": "header",
      "content": "Text Alignment"
    },

    {
      "type": "select",
      "id": "text_alignment",
      "label": "Text alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "center"
    },


    {
      "type": "header",
      "content": "Section Spacing"
    },

    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Padding top",
      "default": 40
    },

    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Padding bottom",
      "default": 40
    }

  ],

  "presets": [
    {
      "name": "Custom Liquid Pro"
    }
  ]

}

{% endschema %}