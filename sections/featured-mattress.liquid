{% if section.settings.product != blank %}

  <section class="featured-mattress">

    <div class="featured-mattress__container">

      <!-- Product Image -->
      <div class="featured-mattress__media">

        {% if section.settings.product.featured_image != blank %}

          <a
            href="{{ section.settings.product.url }}"
            class="featured-mattress__image-link"
          >

            {{
              section.settings.product.featured_image
              | image_url: width: 1400
              | image_tag:
                loading: 'lazy',
                widths: '500, 700, 900, 1100, 1400',
                sizes: '(max-width: 749px) 100vw, 55vw',
                alt: section.settings.product.title
            }}

          </a>

        {% else %}

          <div class="featured-mattress__placeholder">
            Product Image
          </div>

        {% endif %}

        <!-- Floating Badge -->
        <div class="featured-mattress__badge">
          Featured
        </div>

      </div>


      <!-- Product Content -->
      <div class="featured-mattress__content">

        <span class="featured-mattress__eyebrow">
          FEATURED MATTRESS
        </span>


        <h2 class="featured-mattress__title">
          {{ section.settings.product.title }}
        </h2>


        <div class="featured-mattress__rating">

          <span class="featured-mattress__stars">
            ★★★★★
          </span>

          <span class="featured-mattress__rating-text">
            Premium Comfort
          </span>

        </div>


        <!-- Price -->
        <div class="featured-mattress__pricing">

          <span class="featured-mattress__price">
            {{ section.settings.product.price | money }}
          </span>

          {% if section.settings.product.compare_at_price > section.settings.product.price %}

            <span class="featured-mattress__compare-price">
              {{ section.settings.product.compare_at_price | money }}
            </span>

            <span class="featured-mattress__sale">
              Sale
            </span>

          {% endif %}

        </div>


        <!-- Description -->
        <div class="featured-mattress__description">

          {{ section.settings.product.description }}

        </div>


        <!-- Benefits -->
        <div class="featured-mattress__benefits">

          <div class="featured-mattress__benefit">

            <span class="featured-mattress__benefit-icon">
              ✓
            </span>

            <span>
              Premium Quality
            </span>

          </div>


          <div class="featured-mattress__benefit">

            <span class="featured-mattress__benefit-icon">
              ✓
            </span>

            <span>
              Comfort Focused
            </span>

          </div>


          <div class="featured-mattress__benefit">

            <span class="featured-mattress__benefit-icon">
              ✓
            </span>

            <span>
              Easy Shopping
            </span>

          </div>

        </div>


        <!-- Button -->
        <a
          href="{{ section.settings.product.url }}"
          class="featured-mattress__button"
        >

          <span>
            View Product
          </span>

          <span class="featured-mattress__arrow">
            →
          </span>

        </a>


        <!-- Small Trust Text -->
        <p class="featured-mattress__trust">
          Discover comfort designed for better nights.
        </p>

      </div>

    </div>

  </section>


{% else %}

  <div class="featured-mattress__empty">

    <p>
      Please select a product from the Theme Editor.
    </p>

  </div>

{% endif %}


<style>

/* =========================================
   MAIN SECTION
========================================= */

.featured-mattress {
  width: 100%;

  padding: 90px 20px;

  background: #f7f7f5;
}


/* =========================================
   CONTAINER
========================================= */

.featured-mattress__container {

  max-width: 1250px;

  margin: 0 auto;

  display: grid;

  grid-template-columns: 1.15fr 0.85fr;

  gap: 75px;

  align-items: center;
}


/* =========================================
   IMAGE AREA
========================================= */

.featured-mattress__media {

  position: relative;

  overflow: hidden;

  border-radius: 28px;

  background: #e9e9e7;

  box-shadow:
    0 25px 60px rgba(0, 0, 0, 0.08);
}


.featured-mattress__image-link {

  display: block;

  overflow: hidden;
}


.featured-mattress__media img {

  width: 100%;

  height: auto;

  display: block;

  transition:
    transform 0.8s cubic-bezier(.2,.7,.2,1);
}


.featured-mattress__media:hover img {

  transform: scale(1.05);
}


/* =========================================
   BADGE
========================================= */

.featured-mattress__badge {

  position: absolute;

  top: 22px;

  left: 22px;

  padding: 9px 16px;

  border-radius: 50px;

  background: rgba(255,255,255,0.92);

  backdrop-filter: blur(10px);

  color: #171717;

  font-size: 10px;

  font-weight: 700;

  letter-spacing: 1.8px;

  text-transform: uppercase;

  box-shadow:
    0 5px 20px rgba(0,0,0,0.08);
}


/* =========================================
   PLACEHOLDER
========================================= */

.featured-mattress__placeholder {

  min-height: 500px;

  display: flex;

  align-items: center;

  justify-content: center;

  color: #777;

  font-size: 14px;
}


/* =========================================
   CONTENT
========================================= */

.featured-mattress__content {

  padding: 10px 0;
}


.featured-mattress__eyebrow {

  display: block;

  margin-bottom: 18px;

  color: #777;

  font-size: 11px;

  font-weight: 700;

  letter-spacing: 3px;
}


/* =========================================
   TITLE
========================================= */

.featured-mattress__title {

  margin: 0;

  max-width: 550px;

  color: #171717;

  font-size: clamp(38px, 4vw, 58px);

  line-height: 1.05;

  font-weight: 600;

  letter-spacing: -1.8px;
}


/* =========================================
   RATING
========================================= */

.featured-mattress__rating {

  display: flex;

  align-items: center;

  gap: 12px;

  margin-top: 22px;
}


.featured-mattress__stars {

  font-size: 14px;

  letter-spacing: 2px;

  color: #171717;
}


.featured-mattress__rating-text {

  font-size: 12px;

  color: #777;
}


/* =========================================
   PRICING
========================================= */

.featured-mattress__pricing {

  display: flex;

  align-items: center;

  flex-wrap: wrap;

  gap: 12px;

  margin-top: 25px;
}


.featured-mattress__price {

  color: #171717;

  font-size: 27px;

  font-weight: 700;
}


.featured-mattress__compare-price {

  color: #999;

  font-size: 17px;

  text-decoration: line-through;
}


.featured-mattress__sale {

  padding: 5px 10px;

  border-radius: 50px;

  background: #171717;

  color: #fff;

  font-size: 10px;

  font-weight: 700;

  letter-spacing: 1px;

  text-transform: uppercase;
}


/* =========================================
   DESCRIPTION
========================================= */

.featured-mattress__description {

  max-width: 540px;

  margin-top: 25px;

  color: #666;

  font-size: 15px;

  line-height: 1.85;
}


.featured-mattress__description p {

  margin: 0 0 12px;
}


/* =========================================
   BENEFITS
========================================= */

.featured-mattress__benefits {

  display: flex;

  flex-wrap: wrap;

  gap: 18px;

  margin-top: 28px;

  padding-top: 25px;

  border-top: 1px solid #dededb;
}


.featured-mattress__benefit {

  display: flex;

  align-items: center;

  gap: 8px;

  color: #555;

  font-size: 12px;

  font-weight: 500;
}


.featured-mattress__benefit-icon {

  width: 20px;

  height: 20px;

  display: flex;

  align-items: center;

  justify-content: center;

  border-radius: 50%;

  background: #171717;

  color: #fff;

  font-size: 11px;

  font-weight: 700;
}


/* =========================================
   BUTTON
========================================= */

.featured-mattress__button {

  width: fit-content;

  display: inline-flex;

  align-items: center;

  justify-content: center;

  gap: 15px;

  margin-top: 32px;

  padding: 16px 25px;

  border-radius: 50px;

  background: #171717;

  color: #fff;

  font-size: 13px;

  font-weight: 600;

  text-decoration: none;

  transition:
    transform 0.3s ease,
    background 0.3s ease,
    gap 0.3s ease;
}


.featured-mattress__button:hover {

  background: #333;

  transform: translateY(-3px);

  gap: 21px;
}


.featured-mattress__arrow {

  font-size: 18px;

  line-height: 1;
}


/* =========================================
   TRUST TEXT
========================================= */

.featured-mattress__trust {

  margin: 18px 0 0;

  color: #999;

  font-size: 11px;

  letter-spacing: 0.3px;
}


/* =========================================
   EMPTY STATE
========================================= */

.featured-mattress__empty {

  padding: 80px 20px;

  text-align: center;

  color: #777;
}


/* =========================================
   TABLET
========================================= */

@media screen and (max-width: 989px) {

  .featured-mattress {

    padding: 70px 20px;
  }


  .featured-mattress__container {

    gap: 45px;
  }


  .featured-mattress__title {

    font-size: 40px;
  }


  .featured-mattress__benefits {

    gap: 12px;
  }

}


/* =========================================
   MOBILE
========================================= */

@media screen and (max-width: 749px) {

  .featured-mattress {

    padding: 55px 15px;
  }


  .featured-mattress__container {

    grid-template-columns: 1fr;

    gap: 35px;
  }


  .featured-mattress__media {

    border-radius: 20px;
  }


  .featured-mattress__badge {

    top: 16px;

    left: 16px;
  }


  .featured-mattress__content {

    padding: 0 5px;
  }


  .featured-mattress__eyebrow {

    font-size: 10px;

    letter-spacing: 2.5px;
  }


  .featured-mattress__title {

    font-size: 36px;

    letter-spacing: -1px;
  }


  .featured-mattress__price {

    font-size: 24px;
  }


  .featured-mattress__description {

    font-size: 14px;

    line-height: 1.75;
  }


  .featured-mattress__benefits {

    display: grid;

    grid-template-columns: 1fr 1fr;

    gap: 14px;
  }


  .featured-mattress__button {

    width: 100%;
  }

}

</style>


{% schema %}

{
  "name": "Featured Mattress",

  "settings": [

    {
      "type": "product",
      "id": "product",
      "label": "Select product"
    }

  ],

  "presets": [

    {
      "name": "Featured Mattress"
    }

  ]
}

{% endschema %}