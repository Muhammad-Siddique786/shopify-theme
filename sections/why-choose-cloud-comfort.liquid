{% if section.settings.show_section %}
  <section
    class="cloud-comfort-section"
    style="
      background: {{ section.settings.background }};
      text-align: {{ section.settings.text_alignment }};
      padding-top: {{ section.settings.section_spacing }}px;
      padding-bottom: {{ section.settings.section_spacing }}px;
    "
  >
    <div class="cloud-comfort-container">
      <div class="cloud-comfort-header">
        <span class="cloud-comfort-eyebrow"> THE CLOUD COMFORT DIFFERENCE </span>

        <h2 class="cloud-comfort-title">
          {{ section.settings.heading }}
        </h2>

        <div class="cloud-comfort-line"></div>

        {% if section.settings.subheading != blank %}
          <p class="cloud-comfort-subtitle">
            {{ section.settings.subheading }}
          </p>
        {% endif %}
      </div>

      <div class="cloud-comfort-grid">
        {% for block in section.blocks %}
          <div
            class="cloud-comfort-card"
            style="
              --delay: {{ forloop.index0 | times: 0.12 }}s;
                          background: {{ block.settings.background }};
              text-align: {{ block.settings.text_alignment }};
              padding: {{ block.settings.spacing }}px;
            "
            {{ block.shopify_attributes }}
          >
            <div class="cloud-comfort-card-glow"></div>

            <div class="cloud-comfort-icon">
              {% if block.settings.image != blank %}
                {{
                  block.settings.image
                  | image_url: width: 300
                  | image_tag: loading: 'lazy', widths: '150, 200, 300', sizes: '200px', alt: block.settings.heading
                }}

              {% else %}
                <div class="cloud-comfort-placeholder">✦</div>
              {% endif %}
            </div>

            <div class="cloud-comfort-content">
              <h3>
                {{ block.settings.heading }}
              </h3>

              {% if block.settings.description != blank %}
                <p>
                  {{ block.settings.description }}
                </p>
              {% endif %}
            </div>

            <div class="cloud-comfort-card-bottom"></div>
          </div>
        {% endfor %}
      </div>
    </div>
  </section>
{% endif %}
<style>
  /* ===============================
     MAIN SECTION
  =============================== */

  .cloud-comfort-section {
    position: relative;
    width: 100%;
    padding: 90px 20px;
    overflow: hidden;

    background:
      radial-gradient(
        circle at 10% 20%,
        rgba(230, 240, 255, 0.9),
        transparent 35%
      ),
      radial-gradient(
        circle at 90% 80%,
        rgba(245, 235, 255, 0.8),
        transparent 35%
      ),
      #ffffff;
  }


  .cloud-comfort-container {
    width: 100%;
    max-width: 1250px;
    margin: 0 auto;
  }


  /* ===============================
     HEADER
  =============================== */

  .cloud-comfort-header {
    text-align: center;
    margin-bottom: 55px;
  }


  .cloud-comfort-eyebrow {
    display: inline-block;

    margin-bottom: 14px;

    font-size: 12px;
    font-weight: 700;

    letter-spacing: 3px;

    color: #777;

    text-transform: uppercase;
  }


  .cloud-comfort-title {
    margin: 0;

    font-size: clamp(32px, 4vw, 52px);

    line-height: 1.1;

    font-weight: 700;

    letter-spacing: -1px;

    color: #171717;
  }


  .cloud-comfort-line {
    width: 70px;
    height: 3px;

    margin: 22px auto 0;

    border-radius: 50px;

    background: linear-gradient(
      90deg,
      #111,
      #aaa,
      #111
    );

    animation: cloudLine 3s ease-in-out infinite;
  }


  .cloud-comfort-subtitle {
    max-width: 650px;

    margin: 22px auto 0;

    font-size: 16px;

    line-height: 1.7;

    color: #666;
  }


  /* ===============================
     GRID
  =============================== */

  .cloud-comfort-grid {
    display: grid;

    grid-template-columns: repeat(4, minmax(0, 1fr));

    gap: 24px;
  }


  /* ===============================
     CARD
  =============================== */

  .cloud-comfort-card {
    position: relative;

    min-height: 340px;

    padding: 38px 25px 32px;

    text-align: center;

    overflow: hidden;

    border: 1px solid rgba(0, 0, 0, 0.07);

    border-radius: 24px;

    background: rgba(255, 255, 255, 0.92);

    box-shadow:
      0 10px 30px rgba(0, 0, 0, 0.06);

    transition:
      transform 0.45s ease,
      box-shadow 0.45s ease,
      border-color 0.45s ease;

    animation:
      cloudCardEnter 0.8s ease both;

    animation-delay: var(--delay);
  }


  .cloud-comfort-card:hover {
    transform: translateY(-12px);

    border-color: rgba(0, 0, 0, 0.14);

    box-shadow:
      0 25px 55px rgba(0, 0, 0, 0.13);
  }


  /* ===============================
     CARD GLOW
  =============================== */

  .cloud-comfort-card-glow {
    position: absolute;

    width: 180px;
    height: 180px;

    top: -90px;
    right: -70px;

    border-radius: 50%;

    background: rgba(220, 235, 255, 0.5);

    filter: blur(25px);

    transition:
      transform 0.6s ease,
      opacity 0.6s ease;
  }


  .cloud-comfort-card:hover
  .cloud-comfort-card-glow {
    transform: scale(1.7);

    opacity: 0.8;
  }


  /* ===============================
     ICON / IMAGE
  =============================== */

  .cloud-comfort-icon {
    position: relative;
    z-index: 2;

    width: 130px;
    height: 130px;

    margin: 0 auto 25px;

    display: flex;

    align-items: center;
    justify-content: center;

    border-radius: 50%;

    background:
      linear-gradient(
        145deg,
        #ffffff,
        #f2f2f2
      );

    box-shadow:
      inset 0 0 0 1px rgba(0,0,0,0.05),
      0 12px 25px rgba(0,0,0,0.08);

    transition:
      transform 0.5s ease,
      box-shadow 0.5s ease;
  }


  .cloud-comfort-card:hover
  .cloud-comfort-icon {
    transform: translateY(-5px) scale(1.06);

    box-shadow:
      inset 0 0 0 1px rgba(0,0,0,0.08),
      0 18px 35px rgba(0,0,0,0.12);
  }


  .cloud-comfort-icon img {
    width: 85px;
    height: 85px;

    object-fit: contain;

    transition:
      transform 0.5s ease;
  }


  .cloud-comfort-card:hover
  .cloud-comfort-icon img {
    transform: scale(1.08);
  }


  .cloud-comfort-placeholder {
    font-size: 45px;

    line-height: 1;

    color: #999;

    animation: cloudFloat 3s ease-in-out infinite;
  }


  /* ===============================
     CONTENT
  =============================== */

  .cloud-comfort-content {
    position: relative;
    z-index: 2;
  }


  .cloud-comfort-content h3 {
    margin: 0 0 12px;

    font-size: 21px;

    line-height: 1.3;

    font-weight: 700;

    color: #171717;

    transition:
      transform 0.35s ease;
  }


  .cloud-comfort-card:hover
  .cloud-comfort-content h3 {
    transform: translateY(-2px);
  }


  .cloud-comfort-content p {
    max-width: 270px;

    margin: 0 auto;

    font-size: 14px;

    line-height: 1.7;

    color: #666;
  }


  /* ===============================
     BOTTOM LINE
  =============================== */

  .cloud-comfort-card-bottom {
    position: absolute;

    left: 50%;
    bottom: 0;

    width: 0;
    height: 3px;

    transform: translateX(-50%);

    border-radius: 20px;

    background: #111;

    transition:
      width 0.45s ease;
  }


  .cloud-comfort-card:hover
  .cloud-comfort-card-bottom {
    width: 55%;
  }


  /* ===============================
     ANIMATIONS
  =============================== */

  @keyframes cloudCardEnter {

    from {
      opacity: 0;

      transform:
        translateY(35px);
    }

    to {
      opacity: 1;

      transform:
        translateY(0);
    }

  }


  @keyframes cloudLine {

    0%,
    100% {
      transform: scaleX(1);
      opacity: 1;
    }

    50% {
      transform: scaleX(1.35);
      opacity: 0.6;
    }

  }


  @keyframes cloudFloat {

    0%,
    100% {
      transform: translateY(0);
    }

    50% {
      transform: translateY(-7px);
    }

  }


  /* ===============================
     TABLET
  =============================== */

  @media screen and (max-width: 990px) {

    .cloud-comfort-section {
      padding: 70px 20px;
    }


    .cloud-comfort-grid {
      grid-template-columns: repeat(2, 1fr);

      gap: 22px;
    }


    .cloud-comfort-card {
      min-height: 330px;
    }

  }


  /* ===============================
     MOBILE
  =============================== */

  @media screen and (max-width: 749px) {

    .cloud-comfort-section {
      padding: 60px 16px;
    }


    .cloud-comfort-header {
      margin-bottom: 40px;
    }


    .cloud-comfort-eyebrow {
      font-size: 10px;

      letter-spacing: 2px;
    }


    .cloud-comfort-title {
      font-size: 32px;
    }


    .cloud-comfort-subtitle {
      font-size: 14px;
    }


    .cloud-comfort-grid {
      grid-template-columns: 1fr;

      gap: 18px;
    }


    .cloud-comfort-card {
      min-height: auto;

      padding: 35px 22px;
    }


    .cloud-comfort-icon {
      width: 110px;
      height: 110px;
    }


    .cloud-comfort-icon img {
      width: 75px;
      height: 75px;
    }


    .cloud-comfort-content h3 {
      font-size: 20px;
    }

  }


  /* ===============================
     ACCESSIBILITY
  =============================== */

  @media (prefers-reduced-motion: reduce) {

    .cloud-comfort-card,
    .cloud-comfort-line,
    .cloud-comfort-placeholder,
    .cloud-comfort-icon,
    .cloud-comfort-icon img {
      animation: none !important;

      transition: none !important;
    }

  }
</style>

